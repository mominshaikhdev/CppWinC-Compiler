{
)cppwinc";

    export inline constexpr std::string_view module_epilogue = R"cppwinc(
}
)cppwinc";

    export inline constexpr std::string_view version_string = "1.0.0.0";
    export inline constexpr std::string_view copyright = "MIT License";
}
