    // winrt_base.ixx — the runtime emitted for every projection.

    export inline const std::string base_module_ixx = []() -> std::string
    {
        std::string s;
        s.append(R"cppwinc(
// winrt_base.ixx — generated by cppwinc v1.

module;

// Header-free: the standard library is imported as a module (`import std;`)
// and every Win32/COM API is imported from winversec-projected modules.
// IUnknown/IInspectable are laid out by hand — the winmd carries functions
// and constants, not COM interface types.

// Header-free: zero #include directives. The standard library arrives via
// the named module (`export import std;`) and every Win32/COM API arrives
// from winversec-projected metadata modules. IUnknown/IInspectable are laid
// out by hand — the winmd carries functions and constants, not COM types.

export module winrt_base;

import std;

@STD_IMPORT@

// Win32/COM APIs from winversec-projected metadata (header-free):
import Windows.Win32.ACTIVATION;
import Windows.Win32.Com;
import Windows.Win32.ERRHANDLINGAPI;
import Windows.Win32.Foundation;
import Windows.Win32.ROAPI;
import Windows.Win32.ROERRORAPI;
import Windows.Win32.STRINGAPISET;
import Windows.Win32.SYSINFOAPI;
import Windows.Win32.WINSTRING;
import Windows.Win32.System.SystemServices;

namespace winrt
{
    // winrt_guid

    export struct winrt_guid
    {
        std::uint32_t data1 = 0;
        std::uint16_t data2 = 0;
        std::uint16_t data3 = 0;
        std::uint8_t data4[8] = {};

        constexpr bool operator==(winrt_guid const& other) const noexcept
        {
            return data1 == other.data1 && data2 == other.data2 && data3 == other.data3 &&
                std::equal(std::begin(data4), std::end(data4), std::begin(other.data4));
        }

        constexpr std::strong_ordering operator<=>(winrt_guid const& other) const noexcept
        {
            if (auto c = data1 <=> other.data1; c != 0) return c;
            if (auto c = data2 <=> other.data2; c != 0) return c;
            if (auto c = data3 <=> other.data3; c != 0) return c;
            return std::lexicographical_compare_three_way(
                std::begin(data4), std::end(data4),
                std::begin(other.data4), std::end(other.data4));
        }

        std::wstring to_string() const
        {
            wchar_t buffer[40];
            std::swprintf(buffer, 40, L"%08x-%04x-%04x-%02x%02x-%02x%02x%02x%02x%02x%02x",
                data1, data2, data3, data4[0], data4[1], data4[2], data4[3],
                data4[4], data4[5], data4[6], data4[7]);
            return buffer;
        }

        // Local GUID ABI layout (header-free): the Win32 GUID is exactly this
        // memory shape, so reinterpretation between winrt_guid and the raw
        // ABI GUID is valid, and COM methods taking GUID const& bind to it.
        struct abi_guid
        {
            std::uint32_t Data1;
            std::uint16_t Data2;
            std::uint16_t Data3;
            std::uint8_t Data4[8];
        };

        operator abi_guid() const noexcept
        {
            abi_guid g{ data1, data2, data3, {} };
            std::copy(std::begin(data4), std::end(data4), std::begin(g.Data4));
            return g;
        }

        static winrt_guid from(abi_guid const& g) noexcept
        {
            winrt_guid result;
            result.data1 = g.Data1;
            result.data2 = g.Data2;
            result.data3 = g.Data3;
            std::copy(std::begin(g.Data4), std::end(g.Data4), result.data4);
            return result;
        }
    };

    export constexpr winrt_guid null_guid{};

    // hresult

    export constexpr std::int32_t hr_ok = 0;
    export constexpr std::int32_t hr_false = 1;
    export constexpr std::int32_t hr_error = 0x80004005;
    export constexpr std::int32_t hr_no_interface = 0x80004002;
    export constexpr std::int32_t hr_pointer = 0x80004003;
    export constexpr std::int32_t hr_invalid_argument = 0x80070057;
    export constexpr std::int32_t hr_out_of_memory = 0x8007000E;
    export constexpr std::int32_t hr_illegal_method_call = 0x8000000E;
    export constexpr std::int32_t hr_canceled = 0x800704C7;
    export constexpr std::int32_t hr_not_implemented = 0x80004001;
    export constexpr std::int32_t hr_access_denied_value = 0x80070005;

    // Win32 constants that carry no winversec projection (header-only
    // macros) are defined here from their documented SDK values. Declared
    // BEFORE hresult_error: what() converts via win32::cp_utf8 and a
    // later declaration would be use-before-declaration inside the class.
    namespace win32
    {
        inline constexpr std::uint32_t cp_utf8 = 65001;
        inline constexpr std::uint32_t format_message_allocate_buffer = 0x00000100;
        inline constexpr std::uint32_t format_message_from_system = 0x00001000;
        inline constexpr std::uint32_t format_message_ignore_inserts = 0x00000200;
        inline constexpr std::int32_t co_e_not_initialized = static_cast<std::int32_t>(0x800401F0);
        inline constexpr std::int32_t e_bounds = static_cast<std::int32_t>(0x8000000B);
        inline constexpr std::int32_t e_changed_state = static_cast<std::int32_t>(0x8000000C);
        inline constexpr std::int32_t e_illegal_method_call = static_cast<std::int32_t>(0x8000000E);
        inline constexpr std::int32_t error_not_found = static_cast<std::int32_t>(0x80070490);
        inline constexpr std::uint32_t infinite_wait = 0xFFFFFFFF;
        inline constexpr std::int32_t facility_win32 = 0x80070000;
        inline constexpr std::uint32_t lang_neutral = 0;
        inline constexpr std::int32_t e_fail = static_cast<std::int32_t>(0x80004005);
    }

    export class hresult_error : public std::exception
    {
        std::int32_t m_value;
        std::wstring m_message;

    public:
        explicit hresult_error(std::int32_t value, std::wstring message = {})
            : m_value(value), m_message(std::move(message))
        {
        }

        std::int32_t value() const noexcept { return m_value; }
        std::wstring message() const { return m_message; }
        char const* what() const noexcept override
        {
            static thread_local std::string utf8;
            namespace sa = Windows::Win32::STRINGAPISET;
            // CHAR projects as std::int8_t (signed char) in the winversec
            // metadata; utf8.data() is char* — same size/ABI, explicit cast
            // required for the const-removed signature.
            int size = sa::WideCharToMultiByte(win32::cp_utf8, 0, m_message.c_str(), (int)m_message.size(), nullptr, 0, nullptr, nullptr);
            utf8.assign(size, '\0');
            if (size)
            {
                sa::WideCharToMultiByte(win32::cp_utf8, 0, m_message.c_str(), (int)m_message.size(), reinterpret_cast<std::int8_t*>(utf8.data()), size, nullptr, nullptr);
            }
            return utf8.c_str();
        }
    };

    export class hresult_access_denied : public hresult_error { using hresult_error::hresult_error; };
    export class hresult_invalid_argument : public hresult_error { using hresult_error::hresult_error; };
    export class hresult_out_of_memory : public hresult_error { using hresult_error::hresult_error; };
    export class hresult_canceled : public hresult_error { using hresult_error::hresult_error; };
    export class hresult_illegal_method_call : public hresult_error { using hresult_error::hresult_error; };
    export class hresult_not_implemented : public hresult_error { using hresult_error::hresult_error; };
    export class hresult_changed_state : public hresult_error { using hresult_error::hresult_error; };
    export class hresult_class_not_available : public hresult_error { using hresult_error::hresult_error; };
    export class hresult_class_not_registered : public hresult_error { using hresult_error::hresult_error; };
    export class hresult_illegal_delegate_assignment : public hresult_error { using hresult_error::hresult_error; };
    export class hresult_illegal_state_change : public hresult_error { using hresult_error::hresult_error; };
    export class hresult_no_interface : public hresult_error { using hresult_error::hresult_error; };
    export class hresult_out_of_bounds : public hresult_error { using hresult_error::hresult_error; };
    export class hresult_wrong_thread : public hresult_error { using hresult_error::hresult_error; };
    export class hresult_type_load : public hresult_error { using hresult_error::hresult_error; };

    // Win32 constants that carry no winversec projection (header-only
    // macros) are defined above, before first use.

    export void check_hresult(std::int32_t value);

    // COM apartment management. The process must initialize an apartment
    // before any WinRT API can be used; RoGetActivationFactory and friends
    // fail with CO_E_NOTINITIALIZED otherwise.

    export enum class apartment_type
    {
        single_threaded,
        multi_threaded,
        asta,
        task_agent,
    };

    export inline void init_apartment(apartment_type type = apartment_type::multi_threaded)
    {
        std::int32_t hr = hr_ok;
        namespace com_ns = Windows::Win32::Com;
        namespace ro_ns = Windows::Win32::ROAPI;
        switch (type)
        {
        case apartment_type::single_threaded:
            hr = com_ns::CoInitializeEx(nullptr, static_cast<std::uint32_t>(com_ns::tagCOINIT::COINIT_APARTMENTTHREADED));
            break;
        case apartment_type::multi_threaded:
            hr = com_ns::CoInitializeEx(nullptr, static_cast<std::uint32_t>(com_ns::tagCOINIT::COINIT_MULTITHREADED));
            break;
        case apartment_type::asta:
            hr = ro_ns::RoInitialize(ro_ns::RO_INIT_TYPE::RO_INIT_SINGLETHREADED);
            break;
        case apartment_type::task_agent:
            hr = ro_ns::RoInitialize(ro_ns::RO_INIT_TYPE::RO_INIT_MULTITHREADED);
            break;
        }
        check_hresult(hr);
    }

    export inline void uninit_apartment() noexcept
    {
        Windows::Win32::ROAPI::RoUninitialize();
    }

    // Boot diagnostics: append a line to boot_log.txt in the exe's working
    // directory. Exported from winrt_base so view modules (which import
    // winrt_base but not the app module) can mark their BuildUI steps.
    // Active in debug (NDEBUG undefined) - silent in release builds.
    export inline void boot_log(char const* s)
    {
#pragma warning(push)
#pragma warning(disable: 4996) // fopen: CRT secure-overload lives in a header, unavailable in import-std context
        std::FILE* f = std::fopen("boot_log.txt", "a");
#pragma warning(pop)
        if (f)
        {
            std::fputs(s, f);
            std::fputc('\n', f);
            std::fclose(f);
        }
    }
    export inline void boot_logf(char const* fmt, void* v)
    {
        (void)fmt; (void)v;
    }

    // Fatal-exception self-report: registered by main via set_crash_reporter.
    // When an uncaught exception reaches terminate(), the exception kind,
    // HRESULT and message are appended to boot_log.txt before the process
    // dies - turning every "stopped working" into a diagnosable event
    // without a debugger attached.
    export inline void crash_report_current_exception() noexcept
    {
        try { throw; }
        catch (hresult_error const& e)
        {
#pragma warning(push)
#pragma warning(disable: 4996)
            std::FILE* f = std::fopen("boot_log.txt", "a");
#pragma warning(pop)
            if (f)
            {
                std::fprintf(f, "crash: hresult_error 0x%08lX: ", static_cast<unsigned long>(e.value()));
                for (wchar_t c : e.message())
                {
                    if (c == L'\n' || c == L'\r') std::fputc(' ', f);
                    else std::fputwc(c, f);
                }
                std::fputc('\n', f);
                std::fclose(f);
            }
        }
        catch (std::exception const& e)
        {
#pragma warning(push)
#pragma warning(disable: 4996)
            std::FILE* f = std::fopen("boot_log.txt", "a");
#pragma warning(pop)
            if (f)
            {
                std::fprintf(f, "crash: std::exception: %s\n", e.what());
                std::fclose(f);
            }
        }
        catch (...)
        {
            boot_log("crash: unknown exception");
        }
    }

    export inline void set_crash_reporter()
    {
        std::set_terminate([]
        {
            crash_report_current_exception();
            std::abort();
        });
    }

    export inline void check_hresult(std::int32_t value)
    {
        if (value < 0)
        {
            wchar_t* buffer = nullptr;
            std::wstring message;
            namespace ss = Windows::Win32::System::SystemServices;
            // FORMAT_MESSAGE_ALLOCATE_BUFFER: the API writes the allocated
            // string pointer through lpBuffer — C callers pass (LPWSTR)&buffer.
            ss::FormatMessageW(win32::format_message_allocate_buffer | win32::format_message_from_system | win32::format_message_ignore_inserts,
                nullptr, static_cast<std::uint32_t>(value), win32::lang_neutral,
                reinterpret_cast<wchar_t*>(&buffer), 0, nullptr);
            if (buffer)
            {
                message = buffer;
                ss::LocalFree(buffer);
                while (!message.empty() && (message.back() == L'\r' || message.back() == L'\n' || message.back() == L' '))
                {
                    message.pop_back();
                }
            }
            switch (value)
            {
            case hr_no_interface: throw hresult_error(value, message);
            case hr_invalid_argument: throw hresult_invalid_argument(value, message);
            case hr_out_of_memory: throw hresult_out_of_memory(value, message);
            case hr_canceled: throw hresult_canceled(value, message);
            case hr_illegal_method_call: throw hresult_illegal_method_call(value, message);
            case hr_not_implemented: throw hresult_not_implemented(value, message);
            case hr_access_denied_value: throw hresult_access_denied(value, message);
            default: throw hresult_error(value, message);
            }
        }
    }

    export inline void check_bool(bool value)
    {
        if (!value)
        {
            throw hresult_error(hr_error);
        }
    }

    // hstring

    export struct hstring
    {
        void* m_ptr = nullptr; // HSTRING

        hstring() noexcept = default;

        hstring(hstring const& other)
        {
            if (other.m_ptr)
            {
                Windows::Win32::WINSTRING::WindowsDuplicateString(other.m_ptr, &m_ptr);
            }
        }

        hstring(hstring&& other) noexcept : m_ptr(other.m_ptr)
        {
            other.m_ptr = nullptr;
        }

        hstring& operator=(hstring const& other)
        {
            if (this != &other)
            {
                hstring copy(other);
                swap(copy);
            }
            return *this;
        }

        hstring& operator=(hstring&& other) noexcept
        {
            if (this != &other)
            {
                detach();
                m_ptr = other.m_ptr;
                other.m_ptr = nullptr;
            }
            return *this;
        }

        hstring(std::wstring_view const& value)
        {
            if (!value.empty())
            {
                Windows::Win32::WINSTRING::WindowsCreateString(value.data(), (std::uint32_t)value.size(), &m_ptr);
            }
        }

        hstring(wchar_t const* value)
        {
            if (value)
            {
                std::wstring_view sv(value);
                if (!sv.empty())
                    Windows::Win32::WINSTRING::WindowsCreateString(sv.data(), (std::uint32_t)sv.size(), &m_ptr);
            }
        }

        ~hstring()
        {
            detach();
        }

        void swap(hstring& other) noexcept
        {
            std::swap(m_ptr, other.m_ptr);
        }

        void detach() noexcept
        {
            if (m_ptr)
            {
                Windows::Win32::WINSTRING::WindowsDeleteString(m_ptr);
                m_ptr = nullptr;
            }
        }

        void* put() noexcept
        {
            detach();
            return &m_ptr;
        }

        bool empty() const noexcept
        {
            return to_view().empty();
        }

        std::wstring_view to_view() const noexcept
        {
            if (!m_ptr) return {};
            std::uint32_t length = 0;
            wchar_t const* data = Windows::Win32::WINSTRING::WindowsGetStringRawBuffer(m_ptr, &length);
            return { data, length };
        }

        // C-string access for emitted helpers (style_from_name etc.) and any
        // std API taking wchar_t const*. WindowsGetStringRawBuffer returns a
        // pointer to a null-terminated buffer; a null HSTRING yields L"".
        wchar_t const* c_str() const noexcept
        {
            if (!m_ptr) return L"";
            std::uint32_t length = 0;
            return Windows::Win32::WINSTRING::WindowsGetStringRawBuffer(m_ptr, &length);
        }

        operator std::wstring() const
        {
            return std::wstring(to_view());
        }

        bool operator==(hstring const& other) const noexcept
        {
            return to_view() == other.to_view();
        }

        bool operator!=(hstring const& other) const noexcept
        {
            return to_view() != other.to_view();
        }

        std::strong_ordering operator<=>(hstring const& other) const noexcept
        {
            return to_view() <=> other.to_view();
        }

        std::size_t size() const noexcept
        {
            return to_view().size();
        }

        static hstring from_abi(void* abi) noexcept
        {
            hstring result;
            result.m_ptr = abi;
            return result;
        }

        void* get_abi() const noexcept { return m_ptr; }

        std::int64_t hash() const noexcept
        {
            return (std::int64_t)std::hash<std::wstring_view>{}(to_view());
        }

        hstring operator+(hstring const& other) const
        {
            return hstring(std::wstring(to_view()) + std::wstring(other.to_view()));
        }
    };

    inline std::wstring operator+(std::wstring const& left, hstring const& right)
    {
        return left + std::wstring(right.to_view());
    }

    // interface infrastructure

    // The projection specializes these for every projected interface.
    export template <typename T>
    inline constexpr winrt_guid iid_of = null_guid;

    export template <typename T>
    inline constexpr std::size_t interface_method_count = 0;

    // Generic-interface IID computation. The projection specializes type_kind
    // (0 interface, 1 class, 2 delegate) and type_name (fully-qualified WinRT
    // name, classes only) for every projected type; make_generic_iid in impl
    // implements the pinterface-signature SHA-1 (RFC 4122 v5) algorithm that
    // the OS uses to identify closed generic instantiations.

    export template <typename T>
    inline constexpr std::uint8_t type_kind = 0;

    export template <typename T>
    inline constexpr std::string_view type_name = "";

    // WinRT metadata "signature" for basic (value) generic arguments, used by
    // make_generic_iid to build the pinterface signature exactly as the OS
    // does: value types contribute their metadata signature ("u8", "string",
    // ...), interfaces contribute their raw IID bytes, classes "rc(name;guid)",
    // and delegates "delegate(guid)". Empty means interface (raw IID bytes).
    export template <typename T>
    inline constexpr std::string_view type_signature = "";

    template <>
    inline constexpr std::string_view type_signature<bool> = "b1";
    template <>
    inline constexpr std::string_view type_signature<std::int8_t> = "i1";
    template <>
    inline constexpr std::string_view type_signature<std::int16_t> = "i2";
    template <>
    inline constexpr std::string_view type_signature<std::int32_t> = "i4";
    template <>
    inline constexpr std::string_view type_signature<std::int64_t> = "i8";
    template <>
    inline constexpr std::string_view type_signature<std::uint8_t> = "u1";
    template <>
    inline constexpr std::string_view type_signature<std::uint16_t> = "u2";
    template <>
    inline constexpr std::string_view type_signature<std::uint32_t> = "u4";
    template <>
    inline constexpr std::string_view type_signature<std::uint64_t> = "u8";
    template <>
    inline constexpr std::string_view type_signature<float> = "f4";
    template <>
    inline constexpr std::string_view type_signature<double> = "f8";
    template <>
    inline constexpr std::string_view type_signature<char16_t> = "c2";
    template <>
    inline constexpr std::string_view type_signature<winrt_guid> = "g16";
    template <>
    inline constexpr std::string_view type_signature<hstring> = "string";

    export struct generic_arg
    {
        std::uint8_t kind;
        std::string_view name;
        winrt_guid const& guid;
        std::string_view sig;
    };

    export template <typename T>
    inline constexpr generic_arg generic_arg_of{ type_kind<T>, type_name<T>, iid_of<T>, type_signature<T> };

    // IUnknown (laid out by hand, header-free): the COM vtable is stable
    // ABI, so slots 0-2 are QueryInterface/AddRef/Release on every object.
    export struct IUnknown
        {
            void* m_ptr = nullptr;

            IUnknown() noexcept = default;
            IUnknown(void* ptr) noexcept : m_ptr(ptr) {}
            IUnknown(IUnknown const& other) : m_ptr(other.m_ptr) { if (m_ptr) AddRef_thunk(); }
            IUnknown(IUnknown&& other) noexcept : m_ptr(other.m_ptr) { other.m_ptr = nullptr; }
            IUnknown& operator=(IUnknown const& other) { if (this != &other) { IUnknown copy(other); std::swap(m_ptr, copy.m_ptr); } return *this; }
            IUnknown& operator=(IUnknown&& other) noexcept { if (this != &other) { if (m_ptr) Release_thunk(); m_ptr = other.m_ptr; other.m_ptr = nullptr; } return *this; }
            ~IUnknown() { if (m_ptr) Release_thunk(); }
            void* get_abi() const noexcept { return m_ptr; }
            static IUnknown from_abi(void* ptr) noexcept { return IUnknown(ptr); }
            explicit operator bool() const noexcept { return m_ptr != nullptr; }

            private:
                void AddRef_thunk() const { auto* vt = *reinterpret_cast<void* const**>(m_ptr); reinterpret_cast<std::uint32_t(__stdcall*)(void*)>(vt[1])(m_ptr); }
                void Release_thunk() const { auto* vt = *reinterpret_cast<void* const**>(m_ptr); reinterpret_cast<std::uint32_t(__stdcall*)(void*)>(vt[2])(m_ptr); }
            public:

            std::uint32_t AddRef() const noexcept
            {
                auto* vt = *reinterpret_cast<void* const**>(m_ptr);
                return reinterpret_cast<std::uint32_t(__stdcall*)(void*)>(vt[1])(m_ptr);
            }
            std::uint32_t Release() const noexcept
            {
                auto* vt = *reinterpret_cast<void* const**>(m_ptr);
                return reinterpret_cast<std::uint32_t(__stdcall*)(void*)>(vt[2])(m_ptr);
            }
            std::int32_t QueryInterface(winrt_guid const& iid, void** result) const noexcept
            {
                auto* vt = *reinterpret_cast<void* const**>(m_ptr);
                return reinterpret_cast<std::int32_t(__stdcall*)(void*, winrt_guid const&, void**)>(vt[0])(m_ptr, iid, result);
            }

            // vtable-level refcount on a RAW object pointer (no wrapper):
            // use these whenever caller code holds a borrowed/raw COM
            // pointer and must adjust its refcount. A
            // static_cast<IUnknown*>(raw)->AddRef() would read the
            // object's vtable slot as m_ptr and call through garbage.
            static void addref_raw(void* raw) noexcept { if (raw) { auto* vt = *reinterpret_cast<void* const**>(raw); reinterpret_cast<std::uint32_t(__stdcall*)(void*)>(vt[1])(raw); } }
            static void release_raw(void* raw) noexcept { if (raw) { auto* vt = *reinterpret_cast<void* const**>(raw); reinterpret_cast<std::uint32_t(__stdcall*)(void*)>(vt[2])(raw); } }
            static std::int32_t qi_raw(void* raw, winrt_guid const& iid, void** result) noexcept { if (!raw) { return hr_no_interface; } auto* vt = *reinterpret_cast<void* const**>(raw); return reinterpret_cast<std::int32_t(__stdcall*)(void*, winrt_guid const&, void**)>(vt[0])(raw, iid, result); }
        };

    // IIDs of the base interfaces (documented SDK values; the winmd does
    // not carry named IID constants).
    export constexpr winrt_guid iid_iunknown{ 0x00000000, 0x0000, 0x0000, { 0xC0, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x46 } };
    export constexpr winrt_guid iid_iinspectable{ 0xAF86E2E0, 0xB12D, 0x4C6A, { 0x9C, 0x5A, 0xD7, 0xAA, 0x65, 0x10, 0x1E, 0x90 } };

    // IInspectable (defined here to avoid a dependency on the
    // Windows.Foundation projection)

    export struct IInspectable
        {
            void* m_ptr = nullptr;

            IInspectable() noexcept = default;
            IInspectable(void* ptr) noexcept : m_ptr(ptr) {}
            IInspectable(IInspectable const& other) : m_ptr(other.m_ptr) { if (m_ptr) IUnknown::addref_raw(m_ptr); }
            IInspectable(IInspectable&& other) noexcept : m_ptr(other.m_ptr) { other.m_ptr = nullptr; }
            IInspectable& operator=(IInspectable const& other) { if (this != &other) { IInspectable copy(other); std::swap(m_ptr, copy.m_ptr); } return *this; }
            IInspectable& operator=(IInspectable&& other) noexcept { if (this != &other) { m_ptr = other.m_ptr; other.m_ptr = nullptr; } return *this; }
            ~IInspectable() { if (m_ptr) IUnknown::release_raw(m_ptr); }
            void* get_abi() const noexcept { return m_ptr; }
            void** put() noexcept { if (m_ptr) IUnknown::release_raw(m_ptr); m_ptr = nullptr; return &m_ptr; }
            static IInspectable from_abi(void* ptr) noexcept { return IInspectable(ptr); }
            explicit operator bool() const noexcept { return m_ptr != nullptr; }
            friend auto operator<=>(IInspectable const&, IInspectable const&) = default;
            bool operator==(std::nullptr_t) const noexcept { return m_ptr == nullptr; }

            winrt::hstring GetRuntimeClassName() const
            {
                auto* vt = *reinterpret_cast<void* const**>(m_ptr);
                auto fn = reinterpret_cast<std::int32_t(__stdcall*)(void*, void**)>(vt[4]);
                void* result = nullptr;
                winrt::check_hresult(fn(m_ptr, &result));
                return winrt::hstring::from_abi(result);
            }
        };

        template <>
    inline constexpr winrt_guid iid_of<IInspectable> = iid_iinspectable;

    // ABI-IID used for interface queries against a projected RUNTIME CLASS
    // instance (event registration, try_as, ...). The outer class name only
    // keys the method dispatch tables, so iid_of<OuterClass> holds whatever
    // inner interface was emitted last — querying with it returns a pointer
    // whose vtable belongs to a different interface, corrupting every call
    // made through it. Projected classes expose their true default-interface
    // IID as a member constant (abi_iid); the trait reads it when present and
    // falls back to IInspectable for wrappers without one. Placed here (after
    // iid_iinspectable) because the fallback constant references it. Partial
    // specializations of exported templates are auto-exported (no export
    // keyword allowed on them).
    export template <typename T, typename = void>
    inline constexpr winrt_guid iid_of_abi = iid_iinspectable;

    template <typename T>
    inline constexpr winrt_guid iid_of_abi<T, std::void_t<decltype(T::abi_iid)>> = T::abi_iid;

    // impl: query_interface (declared before com_ptr, which references it)

    namespace impl
    {
        export inline std::int32_t query_interface(void* unknown, winrt_guid const& iid, void** result) noexcept
        {
            if (!unknown)
            {
                return hr_no_interface;
            }
            // `unknown` is a raw COM object pointer (its first 8 bytes are
            // its real vtable), NOT an IUnknown wrapper. Wrap it first —
            // static_cast would read the object's vtable as the wrapper's
            // m_ptr and call through garbage.
            return IUnknown::qi_raw(unknown, iid, result);
        }
    }

    // Generic-interface IID (pinterface) computation. Matches the OS
    // algorithm (and cppwinrt's): SHA-1 over the namespace GUID plus the
    // UTF-8 signature "pinterface(<pattern guid bytes>;<arg sigs>)", where an
    // interface arg contributes its 16 guid bytes, a class contributes
    // "rc(<name>;<guid bytes>)", and a delegate "delegate(<guid bytes>)";
    // the digest becomes an RFC 4122 version-5 UUID (big-endian packed,
    // then endian-swapped).

    namespace impl
    {
        export inline void put_guid_bytes(std::vector<std::uint8_t>& out, winrt_guid const& g) noexcept
        {
            out.push_back(static_cast<std::uint8_t>(g.data1));
            out.push_back(static_cast<std::uint8_t>(g.data1 >> 8));
            out.push_back(static_cast<std::uint8_t>(g.data1 >> 16));
            out.push_back(static_cast<std::uint8_t>(g.data1 >> 24));
            out.push_back(static_cast<std::uint8_t>(g.data2));
            out.push_back(static_cast<std::uint8_t>(g.data2 >> 8));
            out.push_back(static_cast<std::uint8_t>(g.data3));
            out.push_back(static_cast<std::uint8_t>(g.data3 >> 8));
            for (int i = 0; i < 8; ++i)
            {
                out.push_back(g.data4[i]);
            }
        }

        export inline void put_ascii(std::vector<std::uint8_t>& out, std::string_view s) noexcept
        {
            for (char c : s)
            {
                out.push_back(static_cast<std::uint8_t>(c));
            }
        }

        export inline void put_ascii_guid(std::vector<std::uint8_t>& out, winrt_guid const& g) noexcept
        {
            auto hex = [](std::vector<std::uint8_t>& o, std::uint32_t v, int n) noexcept
            {
                static char const digits[] = "0123456789abcdef";
                for (int i = (n - 1) * 4; i >= 0; i -= 4)
                {
                    o.push_back(static_cast<std::uint8_t>(digits[(v >> i) & 0xF]));
                }
            };
            out.push_back('{');
            hex(out, g.data1, 8);
            out.push_back('-');
            hex(out, g.data2, 4);
            out.push_back('-');
            hex(out, g.data3, 4);
            out.push_back('-');
            hex(out, (static_cast<std::uint32_t>(g.data4[0]) << 8) | g.data4[1], 4);
            out.push_back('-');
            hex(out, (static_cast<std::uint32_t>(g.data4[2]) << 8) | g.data4[3], 4);
            hex(out, (static_cast<std::uint32_t>(g.data4[4]) << 8) | g.data4[5], 4);
            hex(out, (static_cast<std::uint32_t>(g.data4[6]) << 8) | g.data4[7], 4);
            out.push_back('}');
        }

        export inline void sha1(std::vector<std::uint8_t> const& msg, std::uint8_t digest[20]) noexcept
        {
            std::uint32_t h[5] = { 0x67452301, 0xEFCDAB89, 0x98BADCFE, 0x10325476, 0xC3D2E1F0 };
            std::size_t len = msg.size();
            std::vector<std::uint8_t> padded(msg);
            padded.push_back(0x80);
            while (padded.size() % 64 != 56)
            {
                padded.push_back(0);
            }
            std::uint64_t bits = static_cast<std::uint64_t>(len) * 8;
            for (int i = 7; i >= 0; --i)
            {
                padded.push_back(static_cast<std::uint8_t>(bits >> (i * 8)));
            }

            for (std::size_t off = 0; off < padded.size(); off += 64)
            {
                std::uint32_t w[80];
                for (int t = 0; t < 16; ++t)
                {
                    w[t] = (static_cast<std::uint32_t>(padded[off + t * 4]) << 24)
                        | (static_cast<std::uint32_t>(padded[off + t * 4 + 1]) << 16)
                        | (static_cast<std::uint32_t>(padded[off + t * 4 + 2]) << 8)
                        | static_cast<std::uint32_t>(padded[off + t * 4 + 3]);
                }
                auto rotl = [](std::uint8_t n, std::uint32_t x) noexcept { return (x << n) | (x >> (32 - n)); };
                for (int t = 16; t < 80; ++t)
                {
                    w[t] = rotl(1, w[t - 3] ^ w[t - 8] ^ w[t - 14] ^ w[t - 16]);
                }
                std::uint32_t a = h[0], b = h[1], c = h[2], d = h[3], e = h[4];
                for (int t = 0; t < 80; ++t)
                {
                    std::uint32_t f, k;
                    if (t < 20) { f = (b & c) ^ (~b & d); k = 0x5A827999; }
                    else if (t < 40) { f = b ^ c ^ d; k = 0x6ED9EBA1; }
                    else if (t < 60) { f = (b & c) ^ (b & d) ^ (c & d); k = 0x8F1BBCDC; }
                    else { f = b ^ c ^ d; k = 0xCA62C1D6; }
                    std::uint32_t temp = rotl(5, a) + f + e + k + w[t];
                    e = d; d = c; c = rotl(30, b); b = a; a = temp;
                }
                h[0] += a; h[1] += b; h[2] += c; h[3] += d; h[4] += e;
            }
            for (int i = 0; i < 20; ++i)
            {
                digest[i] = static_cast<std::uint8_t>(h[i >> 2] >> (8 * (3 - (i & 3))));
            }
        }

        export inline winrt_guid make_generic_iid(winrt_guid const& pattern, generic_arg const* args, std::size_t count) noexcept
        {
            std::vector<std::uint8_t> msg;
            msg.reserve(10 + 16 + count * 64);
            winrt_guid const ns{ 0xd57af411, 0x737b, 0xc042, { 0xab, 0xae, 0x87, 0x8b, 0x1e, 0x16, 0xad, 0xee } };
            put_guid_bytes(msg, ns);
            put_ascii(msg, "pinterface(");
            put_ascii_guid(msg, pattern);
            msg.push_back(';');
            for (std::size_t i = 0; i < count; ++i)
            {
                auto const& a = args[i];
                if (a.kind == 1)
                {
                    put_ascii(msg, "rc(");
                    put_ascii(msg, a.name);
                    msg.push_back(';');
                    put_ascii_guid(msg, a.guid);
                    msg.push_back(')');
                }
                else if (a.kind == 2)
                {
                    put_ascii(msg, "delegate(");
                    put_ascii_guid(msg, a.guid);
                    msg.push_back(')');
                }
                else if (!a.sig.empty())
                {
                    // basic (value) type: its metadata signature, e.g. "u8",
                    // "string", "i4" - identical to the OS algorithm.
                    put_ascii(msg, a.sig);
                }
                else if (a.guid == winrt_guid{ 0xAF86E2E0, 0xB12D, 0x4C6A, { 0x9C, 0x5A, 0xD7, 0xAA, 0x65, 0x10, 0x1E, 0x90 } })
                {
                    // IInspectable argument: the OS pinterface grammar spells
                    // it cinterface(IInspectable) (C++/WinRT
                    // basic_signature_v<IInspectable>), NOT raw IID bytes.
                    put_ascii(msg, "cinterface(IInspectable)");
                }
                else
                {
                    // interface: the raw IID bytes.
                    put_ascii_guid(msg, a.guid);
                }
                if (i + 1 < count)
                {
                    msg.push_back(';');
                }
            }
            msg.push_back(')');

            std::uint8_t digest[20];
            sha1(msg, digest);

            winrt_guid result
            {
                (static_cast<std::uint32_t>(digest[0]) << 24) | (static_cast<std::uint32_t>(digest[1]) << 16)
                    | (static_cast<std::uint32_t>(digest[2]) << 8) | static_cast<std::uint32_t>(digest[3]),
                (static_cast<std::uint32_t>(digest[4]) << 8) | static_cast<std::uint32_t>(digest[5]),
                (static_cast<std::uint32_t>(digest[6]) << 8) | static_cast<std::uint32_t>(digest[7]),
                { digest[8], digest[9], digest[10], digest[11], digest[12], digest[13], digest[14], digest[15] }
            };
            result.data3 = static_cast<std::uint16_t>((result.data3 & 0x0FFF) | (5 << 12));
            result.data4[0] = static_cast<std::uint8_t>((result.data4[0] & 0x3F) | 0x80);
            return result;
        }

        export template <typename... Args>
        inline winrt_guid make_generic_iid(winrt_guid const& pattern, generic_arg const& first, Args const&... rest) noexcept
        {
            generic_arg const build[sizeof...(Args) + 1] = { first, rest... };
            return make_generic_iid(pattern, build, sizeof...(Args) + 1);
        }

        // Boxing: raw ABI access to the Windows.Foundation.PropertyValue
        // statics. No SDK ABI header is used - the interface vtable is laid
        // out by hand (slots 0-5 are IUnknown + IInspectable, then the
        // Create* methods in contract order), and the factory is resolved
        // once through RoGetActivationFactory. Pure Fast ABI.
        struct property_value_statics
        {
            // the interface pointer points at the vtable pointer, so the
            // struct holds that pointer: factory->vtbl[N] is vtable entry N
            void** vtbl;
        };

        // Constant-initialized atomic cache. A function-local static here
        // goes through MSVC's thread-safe-static guard thunk, which can
        // report "already initialized" while the cached pointer is still
        // null (observed as call [rax+0x90] on a null factory during
        // launch). Zero means unresolved; callers retry the resolution,
        // which the OS caches internally.
        export inline std::atomic<void*> property_value_factory_cache{ nullptr };

        export inline property_value_statics* property_value_factory()
        {
            namespace ro_ns = Windows::Win32::ROAPI;
            void* cached = property_value_factory_cache.load(std::memory_order_acquire);
            if (cached)
            {
                return reinterpret_cast<property_value_statics*>(cached);
            }
            // Try Windows.Foundation first (SDK), then
            // Microsoft.Windows.Foundation (WASDK 2.3+).
            wchar_t const* candidates[] = {
                L"Windows.Foundation.PropertyValue",
                L"Microsoft.Windows.Foundation.PropertyValue",
            };
            winrt_guid iid = { 0x629BDBC8, 0xD932, 0x4FF4, { 0x96, 0xB9, 0x8D, 0x96, 0xC5, 0xC1, 0xE8, 0x58 } };
            for (auto const* candidate : candidates)
            {
                void* name = nullptr;
                Windows::Win32::WINSTRING::WindowsCreateString(candidate,
                    (std::uint32_t)std::char_traits<wchar_t>::length(candidate), &name);
                void* unknown = nullptr;
                std::int32_t hr = ro_ns::RoGetActivationFactory(name, &iid, &unknown);
                Windows::Win32::WINSTRING::WindowsDeleteString(name);
                if (hr >= 0 && unknown)
                {
                    property_value_factory_cache.store(unknown, std::memory_order_release);
                    return reinterpret_cast<property_value_statics*>(unknown);
                }
            }
            // No PropertyValue factory on this system: fail loudly instead of
            // faulting on a null vtable at the call site.
            check_hresult(win32::e_fail);
            return nullptr;
        }

        export template <typename T>
        inline void* box_value_impl(T const& value)
        {
            auto* factory = property_value_factory();
            void* boxed = nullptr;
            if constexpr (std::is_same_v<T, bool>)
            {
                using fn_t = std::int32_t(__stdcall*)(void*, std::uint8_t, void**);

                check_hresult(reinterpret_cast<fn_t>(factory->vtbl[17])(factory, value ? 1 : 0, &boxed));
            }
            else if constexpr (std::is_same_v<T, std::int8_t> || std::is_same_v<T, std::uint8_t>)
            {
                using fn_t = std::int32_t(__stdcall*)(void*, std::uint8_t, void**);

                check_hresult(reinterpret_cast<fn_t>(factory->vtbl[7])(factory, (std::uint8_t)value, &boxed));
            }
            else if constexpr (std::is_same_v<T, std::int16_t>)
            {
                using fn_t = std::int32_t(__stdcall*)(void*, std::int16_t, void**);

                check_hresult(reinterpret_cast<fn_t>(factory->vtbl[8])(factory, value, &boxed));
            }
            else if constexpr (std::is_same_v<T, std::uint16_t>)
            {
                using fn_t = std::int32_t(__stdcall*)(void*, std::uint16_t, void**);

                check_hresult(reinterpret_cast<fn_t>(factory->vtbl[9])(factory, value, &boxed));
            }
            else if constexpr (std::is_same_v<T, std::int32_t>)
            {
                using fn_t = std::int32_t(__stdcall*)(void*, std::int32_t, void**);

                check_hresult(reinterpret_cast<fn_t>(factory->vtbl[10])(factory, value, &boxed));
            }
            else if constexpr (std::is_same_v<T, std::uint32_t>)
            {
                using fn_t = std::int32_t(__stdcall*)(void*, std::uint32_t, void**);

                check_hresult(reinterpret_cast<fn_t>(factory->vtbl[11])(factory, value, &boxed));
            }
            else if constexpr (std::is_same_v<T, std::int64_t>)
            {
                using fn_t = std::int32_t(__stdcall*)(void*, std::int64_t, void**);

                check_hresult(reinterpret_cast<fn_t>(factory->vtbl[12])(factory, value, &boxed));
            }
            else if constexpr (std::is_same_v<T, std::uint64_t>)
            {
                using fn_t = std::int32_t(__stdcall*)(void*, std::uint64_t, void**);

                check_hresult(reinterpret_cast<fn_t>(factory->vtbl[13])(factory, value, &boxed));
            }
            else if constexpr (std::is_same_v<T, float>)
            {
                using fn_t = std::int32_t(__stdcall*)(void*, float, void**);

                check_hresult(reinterpret_cast<fn_t>(factory->vtbl[14])(factory, value, &boxed));
            }
            else if constexpr (std::is_same_v<T, double>)
            {
                using fn_t = std::int32_t(__stdcall*)(void*, double, void**);

                check_hresult(reinterpret_cast<fn_t>(factory->vtbl[15])(factory, value, &boxed));
            }
            else if constexpr (std::is_same_v<T, char16_t>)
            {
                using fn_t = std::int32_t(__stdcall*)(void*, wchar_t, void**);

                check_hresult(reinterpret_cast<fn_t>(factory->vtbl[16])(factory, (wchar_t)value, &boxed));
            }
            else if constexpr (std::is_same_v<T, hstring>)
            {
                using fn_t = std::int32_t(__stdcall*)(void*, void*, void**);
                check_hresult(reinterpret_cast<fn_t>(factory->vtbl[18])(factory, value.m_ptr, &boxed));
            }
            else if constexpr (std::is_same_v<T, winrt_guid>)
            {
                winrt_guid g = value;
                using fn_t = std::int32_t(__stdcall*)(void*, winrt_guid, void**);
                check_hresult(reinterpret_cast<fn_t>(factory->vtbl[20])(factory, g, &boxed));
            }
            else
            {
                static_assert(std::is_same_v<T, bool>, "box_value: unsupported type");
            }
            return reinterpret_cast<void*>(boxed);
        }
    }

    // com_ptr

    // forward-declared here so com_ptr::as/try_as can branch on it; the
    // definition (and its partial specialization) follow below. The default
    // argument is declared only here — repeating it at the definition is a
    // C4348 redefinition.
    namespace impl
    {
        export template <typename T, typename = void>
        struct has_projected_abi;
    }

    export template <typename T = void>
    struct com_ptr
    {
        T* m_ptr = nullptr;

        com_ptr() noexcept = default;
        com_ptr(std::nullptr_t) noexcept {}
        explicit com_ptr(T* ptr) noexcept : m_ptr(ptr) {}

        com_ptr(com_ptr const& other)
        {
            copy_from(other.m_ptr);
        }

        com_ptr(com_ptr&& other) noexcept : m_ptr(other.m_ptr)
        {
            other.m_ptr = nullptr;
        }

        com_ptr& operator=(com_ptr const& other)
        {
            if (this != &other)
            {
                copy_from(other.m_ptr);
            }
            return *this;
        }

        com_ptr& operator=(com_ptr&& other) noexcept
        {
            if (this != &other)
            {
                reset();
                m_ptr = other.m_ptr;
                other.m_ptr = nullptr;
            }
            return *this;
        }

        com_ptr& operator=(std::nullptr_t) noexcept
        {
            reset();
            return *this;
        }

        ~com_ptr()
        {
            reset();
        }

        void copy_from(T* ptr)
        {
            if (ptr)
            {
                ptr->AddRef();
            }
            auto* old = m_ptr;
            m_ptr = ptr;
            if (old)
            {
                old->Release();
            }
        }

        void reset() noexcept
        {
            auto* old = m_ptr;
            m_ptr = nullptr;
            if (old)
            {
                old->Release();
            }
        }

        T* get() const noexcept { return m_ptr; }
        T* operator->() const noexcept { return m_ptr; }
        T& operator*() const noexcept { return *m_ptr; }
        explicit operator bool() const noexcept { return m_ptr != nullptr; }
        bool operator==(com_ptr const& other) const noexcept { return m_ptr == other.m_ptr; }
        bool operator==(std::nullptr_t) const noexcept { return m_ptr == nullptr; }

        T** put() noexcept
        {
            reset();
            return &m_ptr;
        }

        T** address_of() noexcept { return &m_ptr; }

        void** put_void() noexcept
        {
            reset();
            return reinterpret_cast<void**>(&m_ptr);
        }

        void* const* get_abi() const noexcept
        {
            return reinterpret_cast<void* const*>(&m_ptr);
        }

        T* detach() noexcept
        {
            auto* result = m_ptr;
            m_ptr = nullptr;
            return result;
        }

        static com_ptr attach(T* ptr) noexcept
        {
            com_ptr result;
            result.m_ptr = ptr;
            return result;
        }

        // QI to U: projected wrappers return the wrapper value (from_abi),
        // raw COM types return com_ptr<U>. The wrapper path is what the
        // authoring flow uses (e.g. com_ptr<D>::as<IStringable>()).
        template <typename U>
        auto as() const
        {
            if constexpr (winrt::impl::has_projected_abi<U>::value)
            {
                void* result = nullptr;
                check_hresult(impl::query_interface(m_ptr, iid_of<U>, &result));
                return U::from_abi(result);
            }
            else
            {
                void* result = nullptr;
                check_hresult(impl::query_interface(m_ptr, iid_of<U>, &result));
                return com_ptr<U>::attach(static_cast<U*>(result));
            }
        }

        template <typename U>
        auto try_as() const noexcept
        {
            if constexpr (winrt::impl::has_projected_abi<U>::value)
            {
                void* result = nullptr;
                if (impl::query_interface(m_ptr, iid_of<U>, &result) < 0 || !result)
                {
                    return U{};
                }
                return U::from_abi(result);
            }
            else
            {
                void* result = nullptr;
                if (impl::query_interface(m_ptr, iid_of<U>, &result) < 0 || !result)
                {
                    return nullptr;
                }
                return com_ptr<U>::attach(static_cast<U*>(result));
            }
        }
    };

    template <>
    struct com_ptr<void>
    {
        void* m_ptr = nullptr;

        com_ptr() noexcept = default;
        com_ptr(std::nullptr_t) noexcept {}
        explicit com_ptr(void* ptr) noexcept : m_ptr(ptr) {}

        com_ptr(com_ptr const& other)
        {
            copy_from(other.m_ptr);
        }

        com_ptr(com_ptr&& other) noexcept : m_ptr(other.m_ptr)
        {
            other.m_ptr = nullptr;
        }

        com_ptr& operator=(com_ptr const& other)
        {
            if (this != &other)
            {
                copy_from(other.m_ptr);
            }
            return *this;
        }

        com_ptr& operator=(com_ptr&& other) noexcept
        {
            if (this != &other)
            {
                reset();
                m_ptr = other.m_ptr;
                other.m_ptr = nullptr;
            }
            return *this;
        }

        ~com_ptr()
        {
            reset();
        }

        void copy_from(void* ptr)
        {
            if (ptr)
            {
                IUnknown::addref_raw(ptr);
            }
            auto* old = m_ptr;
            m_ptr = ptr;
            if (old)
            {
                IUnknown::release_raw(old);
            }
        }

        void reset() noexcept
        {
            auto* old = m_ptr;
            m_ptr = nullptr;
            if (old)
            {
                IUnknown::release_raw(old);
            }
        }

        void* get() const noexcept { return m_ptr; }
        explicit operator bool() const noexcept { return m_ptr != nullptr; }
        bool operator==(std::nullptr_t) const noexcept { return m_ptr == nullptr; }

        void** put() noexcept
        {
            reset();
            return &m_ptr;
        }

        void* const* get_abi() const noexcept
        {
            return &m_ptr;
        }

        void* detach() noexcept
        {
            auto* result = m_ptr;
            m_ptr = nullptr;
            return result;
        }

        static com_ptr attach(void* ptr) noexcept
        {
            com_ptr result;
            result.m_ptr = ptr;
            return result;
        }

        template <typename U>
        auto as() const
        {
            if constexpr (winrt::impl::has_projected_abi<U>::value)
            {
                void* result = nullptr;
                check_hresult(impl::query_interface(m_ptr, iid_of<U>, &result));
                return U::from_abi(result);
            }
            else
            {
                void* result = nullptr;
                check_hresult(impl::query_interface(m_ptr, iid_of<U>, &result));
                return com_ptr<U>::attach(static_cast<U*>(result));
            }
        }

        template <typename U>
        auto try_as() const noexcept
        {
            if constexpr (winrt::impl::has_projected_abi<U>::value)
            {
                void* result = nullptr;
                if (impl::query_interface(m_ptr, iid_of<U>, &result) < 0 || !result)
                {
                    return U{};
                }
                return U::from_abi(result);
            }
            else
            {
                void* result = nullptr;
                if (impl::query_interface(m_ptr, iid_of<U>, &result) < 0 || !result)
                {
                    return nullptr;
                }
                return com_ptr<U>::attach(static_cast<U*>(result));
            }
        }
    };

    // generic-parameter (T0/T1) marshaling: the projection cannot know at
    // generation time whether a generic argument is a value type, hstring,
    // or interface, so ABI slots and conversions are resolved per
    // instantiation through arg_in/arg_in_t, put_abi/put_abi_t and bind_in.

    namespace impl
    {
        export template <typename T, typename = void>
        struct arg_in
        {
            using type = std::remove_cvref_t<T>;
        };

        template <typename T>
        struct arg_in<com_ptr<T>>
        {
            using type = void*;
        };

        template <>
        struct arg_in<hstring>
        {
            using type = void*;
        };

        // runtime-class/interface wrapper types (thin structs exposing
        // get_abi() and from_abi(void*)) pass their ABI handle by value
        // across the WinRT boundary — never the wrapper struct itself.
        // WinRT ABI for [in] runtime-class/interface generic parameters is a
        // raw pointer; passing the wrapper by value makes the callee read the
        // struct's address as the object pointer (vftable executed as code).
        template <typename T>
        struct arg_in<T, std::void_t<decltype(std::declval<T const&>().get_abi()),
                                     decltype(T::from_abi(std::declval<void*>()))>>
        {
            using type = void*;
        };

        export template <typename T>
        using arg_in_t = typename arg_in<T>::type;

        export template <typename T>
        auto put_abi(com_ptr<T>& object) noexcept -> T**
        {
            return object.put();
        }

        export auto put_abi(hstring& object) noexcept -> void*
        {
            return object.put();
        }

        export template <typename T>
        std::add_pointer_t<T> put_abi(T& object) noexcept
        {
            return &object;
        }

        export template <typename T>
        using put_abi_t = decltype(put_abi(std::declval<T&>()));

        export template <typename T>
        struct bind_in
        {
            T const& object;

            // wrapper types bound to a void* ABI slot (arg_in_t<T> = void*):
            // pass the raw interface pointer
            operator void*() const noexcept
            {
                return object.get_abi();
            }

            // blittable struct slots: reinterpret the storage in place
            template <typename R, typename = std::enable_if_t<!std::is_same_v<R, void*>>>
            operator R const&() const noexcept
            {
                return reinterpret_cast<R const&>(object);
            }
        };

        export template <typename T>
        bind_in<T> bind(T const& object) noexcept
        {
            return bind_in<T>{ object };
        }
    }

    // com_array

    export template <typename T>
    struct com_array
    {
        T* m_data = nullptr;
        std::uint32_t m_size = 0;
        bool m_owns = false;

        com_array() noexcept = default;

        com_array(com_array&& other) noexcept : m_data(other.m_data), m_size(other.m_size), m_owns(other.m_owns)
        {
            other.m_data = nullptr;
            other.m_size = 0;
            other.m_owns = false;
        }

        com_array& operator=(com_array&& other) noexcept
        {
            if (this != &other)
            {
                if (m_owns && m_data)
                {
                    namespace com_ns = Windows::Win32::Com;
com_ns::CoTaskMemFree(m_data);
                }
                m_data = other.m_data;
                m_size = other.m_size;
                m_owns = other.m_owns;
                other.m_data = nullptr;
                other.m_size = 0;
                other.m_owns = false;
            }
            return *this;
        }

        com_array(com_array const&) = delete;
        com_array& operator=(com_array const&) = delete;

        ~com_array()
        {
            if (m_owns && m_data)
            {
                namespace com_ns = Windows::Win32::Com;
com_ns::CoTaskMemFree(m_data);
            }
        }

        T** put() noexcept
        {
            if (m_owns && m_data)
            {
                namespace com_ns = Windows::Win32::Com;
com_ns::CoTaskMemFree(m_data);
            }
            m_data = nullptr;
            m_size = 0;
            m_owns = false;
            return &m_data;
        }

        T* data() const noexcept { return m_data; }
        std::uint32_t size() const noexcept { return m_size; }
        explicit operator bool() const noexcept { return m_data != nullptr; }

        // takes ownership (COM-allocated out array)
        static com_array from_abi(T* data, std::uint32_t size) noexcept
        {
            com_array result;
            result.m_data = data;
            result.m_size = size;
            result.m_owns = true;
            return result;
        }

        // borrows (caller-owned in-array)
        static com_array wrap(T* data, std::uint32_t size) noexcept
        {
            com_array result;
            result.m_data = data;
            result.m_size = size;
            result.m_owns = false;
            return result;
        }
    };

    // span — non-owning view over a contiguous sequence. Projected input
    // array parameters use winrt::span (like cppwinrt's array_view) instead
    // of com_array, so callers can pass std::vector, C arrays, com_array or
    // an explicit (ptr, size) pair without ownership transfer.

    export template <typename T>
    struct span
    {
        T* m_data = nullptr;
        std::size_t m_size = 0;

        span() noexcept = default;

        span(T* data, std::size_t size) noexcept : m_data(data), m_size(size) {}

        template <std::size_t N>
        span(T (&arr)[N]) noexcept : m_data(arr), m_size(N) {}

        span(com_array<T> const& arr) noexcept : m_data(arr.data()), m_size(arr.size()) {}

        span(std::vector<T>& vec) noexcept : m_data(vec.data()), m_size(vec.size()) {}

        T* data() const noexcept { return m_data; }
        std::size_t size() const noexcept { return m_size; }
        bool empty() const noexcept { return m_size == 0; }
        T& operator[](std::size_t i) const noexcept { return m_data[i]; }
        T* begin() const noexcept { return m_data; }
        T* end() const noexcept { return m_data + m_size; }
        explicit operator bool() const noexcept { return m_data != nullptr; }
    };

    // activation

    namespace impl
    {
        // Local activation registry: maps runtime class names (e.g.
        // L"WinUIGallery.ControlExample") to in-process C++ factories. App
        // classes have no registry entry and the exe exports nothing, so
        // RoActivateInstance/RoGetActivationFactory can NEVER resolve them -
        // every winrt::WinUIGallery::X() construction throws
        // REGDB_E_CLASSNOTAVAILABLE and unwinds XAML (silent death, no crash
        // reporter). main.ixx registers every view module's create_X() before
        // App::Start(); create_instance consults the registry first.
        using local_factory_fn = winrt::IInspectable (*)();
        inline std::unordered_map<std::wstring_view, local_factory_fn>& local_factories()
        {
            static std::unordered_map<std::wstring_view, local_factory_fn> m;
            return m;
        }
        export inline void register_local_factory(std::wstring_view class_name, local_factory_fn fn)
        {
            local_factories()[class_name] = fn;
        }

        export inline void* create_instance(std::wstring_view class_name)
        {
            // Per-call trace: the last ci:<name> line before a silent death
            // names the exact activation that killed the process.
            {
                char buf[160];
                std::size_t n = 0;
                while (n + 1 < sizeof(buf) && n < class_name.size()) { buf[n] = static_cast<char>(class_name[n]); ++n; }
                buf[n] = 0;
                winrt::boot_log((std::string("ci:") + buf).c_str());
            }
            // 1. Local C++ factory (app classes registered by main.ixx)
            auto const& lf = local_factories();
            if (auto it = lf.find(class_name); it != lf.end())
            {
                winrt::boot_log("ci:local-hit");
                winrt::IInspectable inst = it->second();
                void* p = inst.get_abi();
                // The wrapper owns +1 ref and releases it on return; the caller
                // of create_instance expects to own one - AddRef before handing
                // the raw pointer out.
                auto* vt = *reinterpret_cast<void* const**>(p);
                reinterpret_cast<std::uint32_t(__stdcall*)(void*)>(vt[1])(p);
                winrt::boot_log("ci:local-done");
                return p;
            }
            // 2. OS activation (platform classes)
            // Factory path FIRST: WinUI 3 types are not OS-registered for
            // RoActivateInstance (they fail with REGDB_E_CLASSNOTAVAILABLE),
            // but their IActivationFactory resolves through
            // RoGetActivationFactory - the same path the factory-based
            // wrapper ctors use successfully for every other control.
            // IActivationFactory::ActivateInstance is vtable slot 6
            // (IUnknown 0-2, IInspectable 3-5, ActivateInstance 6) and
            // returns an AddRef'd instance.
            winrt::boot_log("ci:os-activate");
            void* name = nullptr;
            check_hresult(Windows::Win32::WINSTRING::WindowsCreateString(class_name.data(), (std::uint32_t)class_name.size(), &name));
            // Raw object pointer out — must be void*, NOT an IInspectable
            // wrapper: a wrapper would own the API-written pointer and its
            // dtor would release the object the caller is handed.
            void* instance = nullptr;
            void* factory = nullptr;
            std::int32_t hr = Windows::Win32::ROAPI::RoGetActivationFactory(name,
                &const_cast<winrt_guid&>(iid_iinspectable), &factory);
            {
                char hb[32];
                std::snprintf(hb, sizeof(hb), "ci:gf=0x%08X", static_cast<unsigned>(hr));
                winrt::boot_log(hb);
            }
            if (hr >= 0 && factory)
            {
                // QI to the STANDARD IActivationFactory: the IInspectable
                // returned by RoGetActivationFactory is the class-specific
                // factory interface whose slot 6 is a parameterized
                // CreateInstance (calling it blind produces garbage HRESULTs
                // like 0xA89DDB80). IActivationFactory (fixed GUID
                // 00000035-...) exposes ActivateInstance(void**) at slot 6
                // for every WinRT class.
                void* af = nullptr;
                std::int32_t qhr = query_interface(factory,
                    winrt_guid{0x00000035, 0x0000, 0x0000, {0xC0, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x46}}, &af);
                {
                    char hb[32];
                    std::snprintf(hb, sizeof(hb), "ci:qi-act=0x%08X", static_cast<unsigned>(qhr));
                    winrt::boot_log(hb);
                }
                if (qhr >= 0 && af)
                {
                    auto* avt = *reinterpret_cast<void* const**>(af);
                    hr = reinterpret_cast<std::int32_t(__stdcall*)(void*, void**)>(avt[6])(af, &instance);
                    {
                        char hb[32];
                        std::snprintf(hb, sizeof(hb), "ci:act=0x%08X", static_cast<unsigned>(hr));
                        winrt::boot_log(hb);
                    }
                    reinterpret_cast<std::uint32_t(__stdcall*)(void*)>(avt[2])(af);
                }
                auto* fvt0 = *reinterpret_cast<void* const**>(factory);
                reinterpret_cast<std::uint32_t(__stdcall*)(void*)>(fvt0[2])(factory);
                if (hr >= 0 && instance)
                {
                    Windows::Win32::WINSTRING::WindowsDeleteString(name);
                    winrt::boot_log("ci:os-done");
                    return instance;
                }
            }
            // Legacy fallback: OS-registered runtime classes (rare here).
            hr = Windows::Win32::ROAPI::RoActivateInstance(name, &instance);
            Windows::Win32::WINSTRING::WindowsDeleteString(name);
            {
                char hb[32];
                std::snprintf(hb, sizeof(hb), "ci:hr=0x%08X", static_cast<unsigned>(hr));
                winrt::boot_log(hb);
            }
            check_hresult(hr);
            winrt::boot_log("ci:os-done");
            return instance;
        }

        export inline void* get_factory(std::wstring_view class_name)
        {
            void* name = nullptr;
            check_hresult(Windows::Win32::WINSTRING::WindowsCreateString(class_name.data(), (std::uint32_t)class_name.size(), &name));
            // Same: raw object pointer out, no owning wrapper.
            void* factory = nullptr;
            std::int32_t hr = Windows::Win32::ROAPI::RoGetActivationFactory(name,
                &const_cast<winrt_guid&>(iid_iinspectable), &factory);
            Windows::Win32::WINSTRING::WindowsDeleteString(name);
            check_hresult(hr);
            return factory;
        }
    }

    export template <typename T>
    T activate_instance()
    {
        return T::from_abi(impl::create_instance(T::class_name()));
    }

    export template <typename T>
    com_ptr<void> get_activation_factory()
    {
        return com_ptr<void>::attach(impl::get_factory(T::class_name()));
    }

    // Zero XAML (winuic philosophy): no XamlReader::Load, no markup parsing,
    // no load_xaml helper. All UI is synthesized programmatically by winuic
    // projection from the winmd layout-tree payload — this projection never
    // loads XAML at runtime.

    // Box a DataTemplate (IInspectable) into the projected wrapper type
    template <typename T>
    T iinspectable_as(void* raw)
    {
        return T::from_abi(raw);
    }

    // interface cache for projected class instances

    namespace impl
    {
        struct iface_cache_entry
        {
            winrt_guid iid{};
            void* ptr = nullptr;
        };

        export struct iface_cache
        {
            std::vector<iface_cache_entry> entries;
            mutable std::mutex mutex;

            iface_cache() noexcept = default;
            iface_cache(iface_cache&& other) noexcept : entries(std::move(other.entries)) {}
            iface_cache& operator=(iface_cache&& other) noexcept
            {
                if (this != &other)
                {
                    for (auto& e : entries)
                    {
                        if (e.ptr)
                        {
                            IUnknown::release_raw(e.ptr);
                        }
                    }
                    entries.clear();
                    entries = std::move(other.entries);
                }
                return *this;
            }
            // A projected class value is copyable (a copy shares the
            // underlying COM object, exactly like com_ptr): the interface
            // cache must be copyable too, or every generated class would get
            // a deleted copy constructor and fail inside std::function-based
            // event handlers. The copied cache deep-copies the QI entries
            // (AddRef) so both copies safely own their cached pointers.
            iface_cache(iface_cache const& other)
            {
                std::lock_guard lock(other.mutex);
                entries.reserve(other.entries.size());
                for (auto const& e : other.entries)
                {
                    if (e.ptr)
                    {
                        IUnknown::addref_raw(e.ptr);
                    }
                    entries.push_back(e);
                }
            }

            iface_cache& operator=(iface_cache const& other)
            {
                if (this != &other)
                {
                    iface_cache copy(other);
                    *this = std::move(copy);
                }
                return *this;
            }

            void* get(winrt_guid const& iid, void* unknown)
            {
                if (!unknown)
                {
                    return nullptr;
                }
                {
                    std::lock_guard lock(mutex);
                    auto it = std::ranges::find_if(entries, [&](auto const& e)
                    {
                        return e.iid == iid && e.ptr;
                    });
                    if (it != entries.end())
                    {
                        return it->ptr;
                    }
                }
                void* result = nullptr;
                // QI through the raw object's real vtable (no wrapper temp).
                std::int32_t hr = IUnknown::qi_raw(unknown, iid, &result);
                if (hr < 0 || !result)
                {
                    return nullptr;
                }
                std::lock_guard lock(mutex);
                if (auto it = std::ranges::find_if(entries, [&](auto& e) { return e.iid == iid; }); it != entries.end())
                {
                    it->ptr = result;
                    return result;
                }
                if (entries.size() < 16)
                {
                    entries.push_back({ iid, result });
                }
                return result;
            }

            ~iface_cache()
            {
                for (auto& e : entries)
                {
                    if (e.ptr)
                    {
                        IUnknown::release_raw(e.ptr);
                    }
                }
            }
        };
    }

    // fast-ABI object machinery (component classes)

    namespace impl
    {
        // Storage layout (first member of every generated interface impl):
        //   [0] vtable_ptr  -> &vtable[0]           (this is also the interface pointer)
        //   [1..6] vtable   -> IUnknown + IInspectable methods
        //   [7..] methods   -> thunks for interface methods
        // get_abi() returns &vtable_ptr; *get_abi() is a real COM vtable, so
        // the pointer is valid for standard COM and for direct vtable calls.

        inline std::int32_t winrt_qi(void* self, winrt_guid const& iid, void** result, void* owner, void* base_object)
        {
            (void)owner;
            // self = interface pointer (= &storage.vtable_ptr)
            if (iid == winrt_guid::from(iid_iunknown) || iid == winrt_guid::from(iid_iinspectable))
            {
                *result = self;
                IUnknown::addref_raw(self);
                return hr_ok;
            }
            // base-class interfaces are delegated to the base object
            if (base_object)
            {
                std::int32_t hr = IUnknown::qi_raw(base_object, iid, result);
                if (hr >= 0)
                {
                    return hr_ok;
                }
            }
            return hr_no_interface;
        }

        // Refcount storage. add_ref/release live on implements as deducing-this
        // members so that a call through a D-typed expression deduces the most
        // derived object (no CRTP downcast needed for ownership/delete).
        struct com_object
        {
            std::atomic<std::int32_t> m_refs{ 1 };

            std::int32_t add_ref() noexcept { return m_refs.fetch_add(1, std::memory_order_relaxed) + 1; }

            std::int32_t release() noexcept { return m_refs.fetch_sub(1, std::memory_order_acq_rel) - 1; }
        };
    }

    export template <typename D, typename... I>
    struct implements
    {
        using implements_type = implements;
        using default_interface = std::tuple_element_t<0, std::tuple<I...>>;

        impl::com_object m_object;

        explicit implements(D&) noexcept {}

        template <typename Self>
        D& owner(this Self& self) noexcept
        {
            return static_cast<D&>(self);
        }

        template <typename Self>
        std::int32_t add_ref(this Self& self) noexcept
        {
            return self.m_object.add_ref();
        }

        template <typename Self>
        std::int32_t release(this Self& self) noexcept
        {
            std::int32_t remaining = self.m_object.release();
            if (remaining == 0)
            {
                delete &self;
            }
            return remaining;
        }

        // COM spelling used by com_ptr<D> and the authoring helpers
        // (make_self, get_strong, ...); forwards to the deducing-this members.
        std::uint32_t AddRef() noexcept
        {
            return static_cast<std::uint32_t>(static_cast<D*>(this)->add_ref());
        }

        std::uint32_t Release() noexcept
        {
            return static_cast<std::uint32_t>(static_cast<D*>(this)->release());
        }

        // strong self-reference for coroutines and event handlers
        template <typename Self>
        com_ptr<D> get_strong(this Self& self) noexcept
        {
            self.add_ref();
            return com_ptr<D>::attach(static_cast<D*>(&self));
        }

        // weak self-reference; null when the object is gone
        template <typename Self>
        com_ptr<D> get_weak(this Self& self) noexcept
        {
            if (void* state = self.weak_ref())
            {
                auto* s = static_cast<weak_ref_state*>(state);
                if (s->strong.load(std::memory_order_acquire) > 0)
                {
                    self.add_ref();
                    return com_ptr<D>::attach(static_cast<D*>(&self));
                }
            }
            return com_ptr<D>{};
        }

        // weak reference support
        struct weak_ref_state
        {
            std::atomic<std::int32_t> strong{ 1 };
            std::atomic<std::int32_t> weak{ 1 };
            void* object = nullptr;
        };

        void* m_weak = nullptr;

        ~implements()
        {
            if (m_weak)
            {
                auto* state = static_cast<weak_ref_state*>(m_weak);
                state->strong.store(0, std::memory_order_release);
                state->weak.fetch_sub(1, std::memory_order_acq_rel);
            }
        }

        void* weak_ref() noexcept
        {
            if (!m_weak)
            {
                m_weak = new weak_ref_state;
                static_cast<weak_ref_state*>(m_weak)->object = static_cast<D*>(this);
            }
            return m_weak;
        }
    };

    // interface impl base (component classes)

    // Storage layout of interface_impl_base<D, I>:
    //   [0] m_vtable_ptr  -> &m_vtable[0]      (this is also the interface pointer)
    //   [1..6] m_vtable   -> IUnknown + IInspectable slots
    //   [7..] m_methods   -> per-interface method thunk slots (vtable tail)
    // get_abi() returns &m_vtable_ptr; *get_abi() is a real COM vtable, so
    // the pointer is valid for standard COM and for direct vtable calls.
    // The vtable is contiguous (m_vtable followed by m_methods), so slot
    // 6 + i is exactly m_methods[i]; the derived impl sets the thunks after
    // construction.

    namespace impl
    {
        export template <typename D, typename I>
        struct interface_impl_base
        {
            void* m_vtable_ptr = nullptr;
            void* m_vtable[6] = {};
            std::array<void*, interface_method_count<I>> m_methods{};
            D* m_owner = nullptr;

            explicit interface_impl_base(D& owner) noexcept
                : m_vtable_ptr(m_vtable), m_owner(&owner)
            {
                m_vtable[0] = reinterpret_cast<void*>(&thunk_qi);
                m_vtable[1] = reinterpret_cast<void*>(&thunk_add_ref);
                m_vtable[2] = reinterpret_cast<void*>(&thunk_release);
                m_vtable[3] = reinterpret_cast<void*>(&thunk_get_iids);
                m_vtable[4] = reinterpret_cast<void*>(&thunk_get_class_name);
                m_vtable[5] = reinterpret_cast<void*>(&thunk_get_trust);
            }

            void* get_abi() const noexcept
            {
                // the interface pointer is the address of the vtable slot
                // (m_vtable_ptr), which is also the object's own address
                return const_cast<void**>(&m_vtable_ptr);
            }

            static interface_impl_base* base_from_abi(void* self) noexcept
            {
                return static_cast<interface_impl_base*>(self);
            }

            // m_owner is already D*, and D's add_ref/release are deducing-this
            // members, so the thunk needs no downcast of its own.
            // Header-free: winrt_guid is ABI-identical to the OS GUID, so
            // the vtable thunks take it directly (__stdcall = __stdcall).
            static std::int32_t __stdcall thunk_qi(void* self, winrt_guid const& iid, void** result) noexcept
            {
                return base_from_abi(self)->m_owner->query_interface(winrt_guid::from(iid), result);
            }

            static std::uint32_t __stdcall thunk_add_ref(void* self) noexcept
            {
                return base_from_abi(self)->m_owner->add_ref();
            }

            static std::uint32_t __stdcall thunk_release(void* self) noexcept
            {
                return base_from_abi(self)->m_owner->release();
            }

            static std::int32_t __stdcall thunk_get_iids(void* self, std::uint32_t* count, winrt_guid** iids) noexcept
            {
                return base_from_abi(self)->m_owner->get_iids(count, iids);
            }

            static std::int32_t __stdcall thunk_get_class_name(void* self, void** name) noexcept
            {
                auto* owner = base_from_abi(self)->m_owner;
                hstring value;
                std::int32_t hr = owner->get_class_name(value);
                if (hr >= 0 && value.m_ptr)
                {
                    *name = value.m_ptr;
                    value.m_ptr = nullptr;
                }
                return hr;
            }

            static std::int32_t __stdcall thunk_get_trust(void* self, std::int32_t* trust) noexcept
            {
                return base_from_abi(self)->m_owner->get_trust(trust);
            }
        };
    }

    // event

    export struct event_token
    {
        std::int64_t value = 0;
        auto operator<=>(event_token const&) const = default;
    };

    export template <typename T>
    struct event
    {
        std::vector<std::pair<event_token, T>> m_handlers;
        std::mutex m_mutex;
        std::int64_t m_next = 1;

        event_token add(T const& handler)
        {
            std::lock_guard lock(m_mutex);
            event_token token{ m_next++ };
            m_handlers.emplace_back(token, handler);
            return token;
        }

        void remove(event_token token)
        {
            std::lock_guard lock(m_mutex);
            std::erase_if(m_handlers, [&](auto const& pair) { return pair.first == token; });
        }

        template <typename... Args>
        void invoke(Args&&... args)
        {
            std::vector<T> snapshot;
            {
                std::lock_guard lock(m_mutex);
                snapshot.reserve(m_handlers.size());
                std::ranges::transform(m_handlers, std::back_inserter(snapshot),
                    [](auto const& pair) { return pair.second; });
            }
            for (auto& handler : snapshot)
            {
                handler(std::forward<Args>(args)...);
            }
        }

        void clear()
        {
            std::lock_guard lock(m_mutex);
            m_handlers.clear();
        }

        std::size_t size() const noexcept { return m_handlers.size(); }
    };

    // Module-relevant utility families.
    //
    // Everything below is self-contained: it touches only the WinRT ABI
    // (plus `import std;`), never projected module types, so it lives once
    // in winrt_base and is shared by every module without recompilation.

    // identity: atomic reference count used by string/weak machinery

    export struct atomic_ref_count
    {
        std::atomic<std::int32_t> count{ 1 };

        std::int32_t increment() noexcept { return count.fetch_add(1, std::memory_order_relaxed) + 1; }

        std::int32_t decrement() noexcept { return count.fetch_sub(1, std::memory_order_acq_rel) - 1; }

        bool is_zero() const noexcept { return count.load(std::memory_order_acquire) == 0; }
    };

    // Single-threaded collections (single_threaded_vector / _map).
    //
    // ABI-level implementations of the Windows.Foundation collection
    // contracts for component authoring. The projected collection types
    // (IVector<T>, IMap<K,V>, the changed-event handlers and args) are thin
    // wrapper structs emitted into the projection modules and cannot be
    // named from this base module, so every interface here is a hand-rolled
    // COM vtable matching the exact slot layout the projection dispatches
    // (IUnknown 0-2, IInspectable 3-5, methods from 6). Elements are stored
    // as the projected value type itself: the wrappers' copy semantics own
    // their resources and their layout IS the ABI layout, so conversion only
    // happens at the boundary slots (arg_in_t<T> in, put_abi_t<T> out). The
    // public factories (single_threaded_vector<T> returning
    // IObservableVector<T>, single_threaded_map<K,V> returning
    // IObservableMap<K,V>) are emitted into the projection module — where
    // the projected types are nameable — as thin wrappers over the raw
    // pointers produced here.

    namespace impl
    {
        // pattern GUIDs of the collection interfaces (make_generic_iid
        // combines these with the generic arguments, exactly as the OS does)
        export constexpr winrt_guid guid_iiterable{ 0xfaa585ea, 0x6214, 0x4217, { 0xaf, 0xda, 0x7f, 0x46, 0xde, 0x58, 0x69, 0xb3 } };
        export constexpr winrt_guid guid_iiterator{ 0x6a79e863, 0x4300, 0x459a, { 0x99, 0x66, 0xcb, 0xb6, 0x60, 0x96, 0x3e, 0xe1 } };
        export constexpr winrt_guid guid_ivectorview{ 0xbbe1fa4c, 0xb0e3, 0x4583, { 0xba, 0xef, 0x1f, 0x1b, 0x2e, 0x48, 0x3e, 0x56 } };
        export constexpr winrt_guid guid_ivector{ 0x913337e9, 0x11a1, 0x4345, { 0xa3, 0xa2, 0x4e, 0x7f, 0x95, 0x6e, 0x22, 0x2d } };
        export constexpr winrt_guid guid_iobservablevector{ 0x5917eb53, 0x50b4, 0x4a0d, { 0xb3, 0x09, 0x65, 0x86, 0x2b, 0x3f, 0x1d, 0xbc } };
        // IReserveableVector<T> (proposal): IVector<T> extended with
        // Reserve(UInt32). Provisional IID — this interface has no official
        // Microsoft GUID yet; the value below is stable so QI works end-to-end
        // and can be swapped in one place when an official one is assigned.
        export constexpr winrt_guid guid_ireserveablevector{ 0x3f7a19c2, 0x6b1e, 0x4d95, { 0x8a, 0x24, 0xd1, 0x5e, 0x9c, 0x47, 0xb3, 0x08 } };
        export constexpr winrt_guid guid_imapview{ 0xe480ce40, 0xa338, 0x4ada, { 0xad, 0xcf, 0x27, 0x22, 0x72, 0xe4, 0x8c, 0xb9 } };
        export constexpr winrt_guid guid_imap{ 0x3c2925fe, 0x8519, 0x45c1, { 0xaa, 0x79, 0x19, 0x7b, 0x67, 0x18, 0xc1, 0xc1 } };
        export constexpr winrt_guid guid_iobservablemap{ 0x65df2bf5, 0xbf39, 0x41b5, { 0xae, 0xbc, 0x5a, 0x9d, 0x86, 0x5e, 0x47, 0x2b } };
        export constexpr winrt_guid guid_ikeyvaluepair{ 0x02b51929, 0xc1c4, 0x4a7e, { 0x89, 0x40, 0x03, 0x12, 0xb5, 0xc1, 0x85, 0x00 } };
        export constexpr winrt_guid guid_ivector_changed_args{ 0x575933df, 0x34fe, 0x4480, { 0xaf, 0x15, 0x07, 0x69, 0x1f, 0x3d, 0x5d, 0x9b } };
        export constexpr winrt_guid guid_imap_changed_args{ 0x9939f4df, 0x050a, 0x4c0f, { 0xaa, 0x60, 0x77, 0x07, 0x5f, 0x9c, 0x47, 0x77 } };

        // Windows.Foundation.Collections.CollectionChange values
        export constexpr std::int32_t collection_change_reset = 0;
        export constexpr std::int32_t collection_change_item_inserted = 1;
        export constexpr std::int32_t collection_change_item_removed = 2;
        export constexpr std::int32_t collection_change_item_changed = 3;

        // COM shell for hand-rolled IInspectable-derived interfaces in this
        // base module. Every interface is a subobject holding its own vtable
        // pointer and a back-pointer to its owner; QI returns each subobject's
        // address, so every interface is a distinct, stable COM pointer.

        export template <typename Owner>
        struct inspectable_iface_base
        {
            void* const* m_vtable = nullptr; // points at the vtable array
            Owner* m_owner = nullptr;

            static inspectable_iface_base* from_self(void* self) noexcept
            {
                return static_cast<inspectable_iface_base*>(self);
            }

            static std::int32_t __stdcall qi(void* self, winrt_guid const& iid, void** result) noexcept
            {
                return from_self(self)->m_owner->query_interface(winrt_guid::from(iid), result);
            }

            static std::uint32_t __stdcall add_ref(void* self) noexcept
            {
                return from_self(self)->m_owner->add_ref();
            }

            static std::uint32_t __stdcall release(void* self) noexcept
            {
                return from_self(self)->m_owner->release();
            }

            static std::int32_t __stdcall get_iids(void* self, std::uint32_t* count, winrt_guid** iids) noexcept
            {
                return from_self(self)->m_owner->get_iids(count, iids);
            }

            static std::int32_t __stdcall get_class_name(void* self, void** name) noexcept
            {
                return from_self(self)->m_owner->get_class_name(name);
            }

            static std::int32_t __stdcall get_trust(void* self, std::int32_t* trust) noexcept
            {
                return from_self(self)->m_owner->get_trust(trust);
            }
        };

        // exception → HRESULT for the noexcept ABI thunks
        export inline std::int32_t catch_to_hresult() noexcept
        {
            try
            {
                throw;
            }
            catch (hresult_error const& e)
            {
                return e.value();
            }
            catch (std::bad_alloc const&)
            {
                return hr_out_of_memory;
            }
            catch (...)
            {
                return hr_error;
            }
        }

        // detects projected wrapper types (interfaces, classes, delegates):
        // thin structs exposing get_abi() and from_abi(void*)
        export template <typename T, typename>
        struct has_projected_abi : std::false_type {};

        // partial specializations of exported templates are auto-exported
        template <typename T>
        struct has_projected_abi<T, std::void_t<decltype(std::declval<T const&>().get_abi()),
                                                decltype(T::from_abi(std::declval<void*>()))>> : std::true_type {};

        // element storage and ABI conversion for a collection value type.
        // stored is the projected type itself; from_abi converts an inbound
        // ABI slot (arg_in_t<T>) into an owned value and to_abi transfers an
        // owned value into an outbound ABI slot (put_abi_t<T>).
        export template <typename T>
        struct collection_element
        {
            using stored = T;

            static T from_abi(arg_in_t<T> const& value)
            {
                if constexpr (std::is_same_v<T, hstring>)
                {
                    hstring result;
                    if (value)
                    {
                        Windows::Win32::WINSTRING::WindowsDuplicateString(value, reinterpret_cast<void**>(&result.m_ptr));
                    }
                    return result;
                }
                else if constexpr (has_projected_abi<T>::value)
                {
                    // arg_in_t<T> is void* for wrapper types — the ABI slot
                    // IS the interface pointer, not a struct containing one
                    T result = T::from_abi(value);
                    if (value)
                    {
                        IUnknown::addref_raw(value);
                    }
                    return result;
                }
                else
                {
                    return value;
                }
            }

            static void to_abi(put_abi_t<T> out, T value)
            {
                if constexpr (std::is_same_v<T, hstring>)
                {
                    *reinterpret_cast<void**>(out) = value.m_ptr;
                    value.m_ptr = nullptr;
                }
                else if constexpr (has_projected_abi<T>::value)
                {
                    *out = std::move(value);
                }
                else
                {
                    *out = value;
                }
            }
        };

        // map keys are stored as the projected type with a total order; the
        // comparator falls back to ABI-pointer ordering for wrapper types
        // without operator<.
        export template <typename K>
        struct map_key_less
        {
            bool operator()(K const& a, K const& b) const noexcept
            {
                if constexpr (requires { a < b; })
                {
                    return a < b;
                }
                else
                {
                    return a.get_abi() < b.get_abi();
                }
            }
        };

        // VectorChanged event-args object (IVectorChangedEventArgs)
        export struct vector_changed_args
        {
            std::atomic<std::int32_t> m_refs{ 1 };
            std::int32_t m_change = 0; // CollectionChange
            std::uint32_t m_index = 0;

            struct event_args_iface : inspectable_iface_base<vector_changed_args>
            {
                static void* const* vtable() noexcept
                {
                    static void* const v[8] =
                    {
                        reinterpret_cast<void*>(&inspectable_iface_base<vector_changed_args>::qi),
                        reinterpret_cast<void*>(&inspectable_iface_base<vector_changed_args>::add_ref),
                        reinterpret_cast<void*>(&inspectable_iface_base<vector_changed_args>::release),
                        reinterpret_cast<void*>(&inspectable_iface_base<vector_changed_args>::get_iids),
                        reinterpret_cast<void*>(&inspectable_iface_base<vector_changed_args>::get_class_name),
                        reinterpret_cast<void*>(&inspectable_iface_base<vector_changed_args>::get_trust),
                        reinterpret_cast<void*>(&get_change),
                        reinterpret_cast<void*>(&get_index),
                    };
                    return v;
                }

                static std::int32_t __stdcall get_change(void* self, std::int32_t* value) noexcept
                {
                    *value = from_self(self)->m_owner->m_change;
                    return hr_ok;
                }

                static std::int32_t __stdcall get_index(void* self, std::uint32_t* value) noexcept
                {
                    *value = from_self(self)->m_owner->m_index;
                    return hr_ok;
                }
            };

            event_args_iface m_args;

            vector_changed_args(std::int32_t change, std::uint32_t index)
                : m_change(change), m_index(index)
            {
                m_args.m_vtable = event_args_iface::vtable();
                m_args.m_owner = this;
            }

            void* get_abi() noexcept { return &m_args; }

            std::uint32_t add_ref() noexcept { return m_refs.fetch_add(1, std::memory_order_relaxed) + 1; }

            std::uint32_t release() noexcept
            {
                std::uint32_t remaining = m_refs.fetch_sub(1, std::memory_order_acq_rel) - 1;
                if (remaining == 0)
                {
                    delete this;
                }
                return remaining;
            }

            std::int32_t query_interface(winrt_guid const& iid, void** result) noexcept
            {
                if (iid == winrt_guid::from(iid_iunknown) || iid == winrt_guid::from(iid_iinspectable) || iid == guid_ivector_changed_args)
                {
                    *result = &m_args;
                    add_ref();
                    return hr_ok;
                }
                *result = nullptr;
                return hr_no_interface;
            }

            std::int32_t get_iids(std::uint32_t* count, winrt_guid** iids) noexcept
            {
                static winrt_guid const list[] =
                {
                    winrt_guid::from(iid_iunknown),
                    winrt_guid::from(iid_iinspectable),
                    guid_ivector_changed_args,
                };
                *count = 3;
                auto* result = new winrt_guid[3];
                std::copy(std::begin(list), std::end(list), result);
                *iids = result;
                return hr_ok;
            }

            std::int32_t get_class_name(void** name) noexcept
            {
                *name = nullptr;
                return hr_ok;
            }

            std::int32_t get_trust(std::int32_t* trust) noexcept
            {
                *trust = 0;
                return hr_ok;
            }
        };

        // iterator over a snapshot of a single-threaded vector
        // (IIterator<T>; slots 6 get_Current, 7 get_HasCurrent, 8 MoveNext,
        // 9 GetMany)
        export template <typename T>
        struct vector_iterator_impl
        {
            using element = collection_element<T>;

            std::atomic<std::int32_t> m_refs{ 1 };
            std::shared_ptr<std::vector<T>> m_snapshot;
            std::size_t m_position = 0;

            struct iterator_iface : inspectable_iface_base<vector_iterator_impl<T>>
            {
                using inspectable_iface_base<vector_iterator_impl<T>>::from_self;

                static void* const* vtable() noexcept
                {
                    static void* const v[10] =
                    {
                        reinterpret_cast<void*>(&inspectable_iface_base<vector_iterator_impl<T>>::qi),
                        reinterpret_cast<void*>(&inspectable_iface_base<vector_iterator_impl<T>>::add_ref),
                        reinterpret_cast<void*>(&inspectable_iface_base<vector_iterator_impl<T>>::release),
                        reinterpret_cast<void*>(&inspectable_iface_base<vector_iterator_impl<T>>::get_iids),
                        reinterpret_cast<void*>(&inspectable_iface_base<vector_iterator_impl<T>>::get_class_name),
                        reinterpret_cast<void*>(&inspectable_iface_base<vector_iterator_impl<T>>::get_trust),
                        reinterpret_cast<void*>(&get_current),
                        reinterpret_cast<void*>(&get_has_current),
                        reinterpret_cast<void*>(&move_next),
                        reinterpret_cast<void*>(&get_many),
                    };
                    return v;
                }

                static std::int32_t __stdcall get_current(void* self, put_abi_t<T> out) noexcept
                {
                    auto* owner = from_self(self)->m_owner;
                    try
                    {
                        if (owner->m_position >= owner->m_snapshot->size())
                        {
                            return 0x8000000B; // E_BOUNDS
                        }
                        element::to_abi(out, (*owner->m_snapshot)[owner->m_position]);
                        return hr_ok;
                    }
                    catch (...)
                    {
                        return catch_to_hresult();
                    }
                }

                static std::int32_t __stdcall get_has_current(void* self, bool* value) noexcept
                {
                    auto* owner = from_self(self)->m_owner;
                    *value = owner->m_position < owner->m_snapshot->size();
                    return hr_ok;
                }

                static std::int32_t __stdcall move_next(void* self, bool* value) noexcept
                {
                    auto* owner = from_self(self)->m_owner;
                    if (owner->m_position + 1 < owner->m_snapshot->size())
                    {
                        ++owner->m_position;
                        *value = true;
                    }
                    else
                    {
                        owner->m_position = owner->m_snapshot->size();
                        *value = false;
                    }
                    return hr_ok;
                }

                static std::int32_t __stdcall get_many(void* self, void* items, std::uint32_t count, std::uint32_t* actual) noexcept
                {
                    auto* owner = from_self(self)->m_owner;
                    try
                    {
                        auto* dst = reinterpret_cast<T*>(items);
                        std::uint32_t n = 0;
                        while (n < count && owner->m_position < owner->m_snapshot->size())
                        {
                            dst[n] = (*owner->m_snapshot)[owner->m_position];
                            ++owner->m_position;
                            ++n;
                        }
                        *actual = n;
                        return hr_ok;
                    }
                    catch (...)
                    {
                        return catch_to_hresult();
                    }
                }
            };

            iterator_iface m_iface;

            explicit vector_iterator_impl(std::shared_ptr<std::vector<T>> snapshot)
                : m_snapshot(std::move(snapshot))
            {
                m_iface.m_vtable = iterator_iface::vtable();
                m_iface.m_owner = this;
            }

            void* get_abi() noexcept { return &m_iface; }

            std::uint32_t add_ref() noexcept { return m_refs.fetch_add(1, std::memory_order_relaxed) + 1; }

            std::uint32_t release() noexcept
            {
                std::uint32_t remaining = m_refs.fetch_sub(1, std::memory_order_acq_rel) - 1;
                if (remaining == 0)
                {
                    delete this;
                }
                return remaining;
            }

            std::int32_t query_interface(winrt_guid const& iid, void** result) noexcept
            {
                static winrt_guid const value_iid = make_generic_iid(guid_iiterator, generic_arg_of<T>);
                if (iid == winrt_guid::from(iid_iunknown) || iid == winrt_guid::from(iid_iinspectable) || iid == value_iid)
                {
                    *result = &m_iface;
                    add_ref();
                    return hr_ok;
                }
                *result = nullptr;
                return hr_no_interface;
            }

            std::int32_t get_iids(std::uint32_t* count, winrt_guid** iids) noexcept
            {
                static winrt_guid const value_iid = make_generic_iid(guid_iiterator, generic_arg_of<T>);
                static winrt_guid const list[] =
                {
                    winrt_guid::from(iid_iunknown),
                    winrt_guid::from(iid_iinspectable),
                    value_iid,
                };
                *count = 3;
                auto* result = new winrt_guid[3];
                std::copy(std::begin(list), std::end(list), result);
                *iids = result;
                return hr_ok;
            }

            std::int32_t get_class_name(void** name) noexcept
            {
                *name = nullptr;
                return hr_ok;
            }

            std::int32_t get_trust(std::int32_t* trust) noexcept
            {
                *trust = 0;
                return hr_ok;
            }
        };

        // the single-threaded vector itself: implements IIterable<T>,
        // IVector<T> (12 methods, slots 6-17), IVectorView<T> (slots 6-9)
        // and IObservableVector<T> (slots 6-7). Each interface is a separate
        // subobject, so QI returns distinct, stable COM pointers.
        export template <typename T>
        struct vector_impl
        {
            using element = collection_element<T>;

            std::atomic<std::int32_t> m_refs{ 1 };
            std::mutex m_guard;
            std::vector<T> m_values;
            event<std::function<void(void*, void*)>> m_changed; // (sender, args)

            struct iterable_iface : inspectable_iface_base<vector_impl<T>>
            {
                using inspectable_iface_base<vector_impl<T>>::from_self;

                static void* const* vtable() noexcept
                {
                    static void* const v[7] =
                    {
                        reinterpret_cast<void*>(&inspectable_iface_base<vector_impl<T>>::qi),
                        reinterpret_cast<void*>(&inspectable_iface_base<vector_impl<T>>::add_ref),
                        reinterpret_cast<void*>(&inspectable_iface_base<vector_impl<T>>::release),
                        reinterpret_cast<void*>(&inspectable_iface_base<vector_impl<T>>::get_iids),
                        reinterpret_cast<void*>(&inspectable_iface_base<vector_impl<T>>::get_class_name),
                        reinterpret_cast<void*>(&inspectable_iface_base<vector_impl<T>>::get_trust),
                        reinterpret_cast<void*>(&first),
                    };
                    return v;
                }

                static std::int32_t __stdcall first(void* self, void** result) noexcept
                {
                    auto* owner = from_self(self)->m_owner;
                    try
                    {
                        *result = owner->make_iterator();
                        return hr_ok;
                    }
                    catch (...)
                    {
                        return catch_to_hresult();
                    }
                }
            };

            struct vector_iface : inspectable_iface_base<vector_impl<T>>
            {
                using inspectable_iface_base<vector_impl<T>>::from_self;

                static void* const* vtable() noexcept
                {
                    static void* const v[18] =
                    {
                        reinterpret_cast<void*>(&inspectable_iface_base<vector_impl<T>>::qi),
                        reinterpret_cast<void*>(&inspectable_iface_base<vector_impl<T>>::add_ref),
                        reinterpret_cast<void*>(&inspectable_iface_base<vector_impl<T>>::release),
                        reinterpret_cast<void*>(&inspectable_iface_base<vector_impl<T>>::get_iids),
                        reinterpret_cast<void*>(&inspectable_iface_base<vector_impl<T>>::get_class_name),
                        reinterpret_cast<void*>(&inspectable_iface_base<vector_impl<T>>::get_trust),
                        reinterpret_cast<void*>(&get_at),
                        reinterpret_cast<void*>(&get_size),
                        reinterpret_cast<void*>(&get_view),
                        reinterpret_cast<void*>(&index_of),
                        reinterpret_cast<void*>(&set_at),
                        reinterpret_cast<void*>(&insert_at),
                        reinterpret_cast<void*>(&remove_at),
                        reinterpret_cast<void*>(&append),
                        reinterpret_cast<void*>(&remove_at_end),
                        reinterpret_cast<void*>(&clear),
                        reinterpret_cast<void*>(&get_many),
                        reinterpret_cast<void*>(&replace_all),
                    };
                    return v;
                }

                static std::int32_t __stdcall get_at(void* self, std::uint32_t index, put_abi_t<T> out) noexcept
                {
                    auto* owner = from_self(self)->m_owner;
                    try
                    {
                        std::lock_guard lock(owner->m_guard);
                        if (index >= owner->m_values.size())
                        {
                            return 0x8000000B; // E_BOUNDS
                        }
                        element::to_abi(out, owner->m_values[index]);
                        return hr_ok;
                    }
                    catch (...)
                    {
                        return catch_to_hresult();
                    }
                }

                static std::int32_t __stdcall get_size(void* self, std::uint32_t* value) noexcept
                {
                    auto* owner = from_self(self)->m_owner;
                    std::lock_guard lock(owner->m_guard);
                    *value = (std::uint32_t)owner->m_values.size();
                    return hr_ok;
                }

                static std::int32_t __stdcall get_view(void* self, void** result) noexcept
                {
                    auto* owner = from_self(self)->m_owner;
                    *result = &owner->m_view;
                    owner->add_ref();
                    return hr_ok;
                }

                static std::int32_t __stdcall index_of(void* self, arg_in_t<T> value, std::uint32_t* index, bool* result) noexcept
                {
                    auto* owner = from_self(self)->m_owner;
                    try
                    {
                        T needle = element::from_abi(value);
                        std::lock_guard lock(owner->m_guard);
                        for (std::size_t i = 0; i < owner->m_values.size(); ++i)
                        {
                            if (owner->m_values[i] == needle)
                            {
                                *index = (std::uint32_t)i;
                                *result = true;
                                return hr_ok;
                            }
                        }
                        *index = 0;
                        *result = false;
                        return hr_ok;
                    }
                    catch (...)
                    {
                        return catch_to_hresult();
                    }
                }

                static std::int32_t __stdcall set_at(void* self, std::uint32_t index, arg_in_t<T> value) noexcept
                {
                    auto* owner = from_self(self)->m_owner;
                    try
                    {
                        T converted = element::from_abi(value);
                        {
                            std::lock_guard lock(owner->m_guard);
                            if (index >= owner->m_values.size())
                            {
                                return 0x8000000B; // E_BOUNDS
                            }
                            owner->m_values[index] = std::move(converted);
                        }
                        owner->fire_changed(collection_change_item_changed, index);
                        return hr_ok;
                    }
                    catch (...)
                    {
                        return catch_to_hresult();
                    }
                }

                static std::int32_t __stdcall insert_at(void* self, std::uint32_t index, arg_in_t<T> value) noexcept
                {
                    auto* owner = from_self(self)->m_owner;
                    try
                    {
                        T converted = element::from_abi(value);
                        {
                            std::lock_guard lock(owner->m_guard);
                            if (index > owner->m_values.size())
                            {
                                return 0x8000000B; // E_BOUNDS
                            }
                            owner->m_values.insert(owner->m_values.begin() + index, std::move(converted));
                        }
                        owner->fire_changed(collection_change_item_inserted, index);
                        return hr_ok;
                    }
                    catch (...)
                    {
                        return catch_to_hresult();
                    }
                }

                static std::int32_t __stdcall remove_at(void* self, std::uint32_t index) noexcept
                {
                    auto* owner = from_self(self)->m_owner;
                    try
                    {
                        {
                            std::lock_guard lock(owner->m_guard);
                            if (index >= owner->m_values.size())
                            {
                                return 0x8000000B; // E_BOUNDS
                            }
                            owner->m_values.erase(owner->m_values.begin() + index);
                        }
                        owner->fire_changed(collection_change_item_removed, index);
                        return hr_ok;
                    }
                    catch (...)
                    {
                        return catch_to_hresult();
                    }
                }

                static std::int32_t __stdcall append(void* self, arg_in_t<T> value) noexcept
                {
                    auto* owner = from_self(self)->m_owner;
                    try
                    {
                        T converted = element::from_abi(value);
                        std::uint32_t index = 0;
                        {
                            std::lock_guard lock(owner->m_guard);
                            index = (std::uint32_t)owner->m_values.size();
                            owner->m_values.push_back(std::move(converted));
                        }
                        owner->fire_changed(collection_change_item_inserted, index);
                        return hr_ok;
                    }
                    catch (...)
                    {
                        return catch_to_hresult();
                    }
                }

                static std::int32_t __stdcall remove_at_end(void* self) noexcept
                {
                    auto* owner = from_self(self)->m_owner;
                    try
                    {
                        std::uint32_t index = 0;
                        {
                            std::lock_guard lock(owner->m_guard);
                            if (owner->m_values.empty())
                            {
                                return hr_ok;
                            }
                            index = (std::uint32_t)owner->m_values.size() - 1;
                            owner->m_values.pop_back();
                        }
                        owner->fire_changed(collection_change_item_removed, index);
                        return hr_ok;
                    }
                    catch (...)
                    {
                        return catch_to_hresult();
                    }
                }

                static std::int32_t __stdcall clear(void* self) noexcept
                {
                    auto* owner = from_self(self)->m_owner;
                    try
                    {
                        {
                            std::lock_guard lock(owner->m_guard);
                            owner->m_values.clear();
                        }
                        owner->fire_changed(collection_change_reset, 0);
                        return hr_ok;
                    }
                    catch (...)
                    {
                        return catch_to_hresult();
                    }
                }

                static std::int32_t __stdcall get_many(void* self, std::uint32_t start_index, void* items, std::uint32_t count, std::uint32_t* actual) noexcept
                {
                    auto* owner = from_self(self)->m_owner;
                    try
                    {
                        std::lock_guard lock(owner->m_guard);
                        if (start_index > owner->m_values.size())
                        {
                            return 0x8000000B; // E_BOUNDS
                        }
                        auto* dst = reinterpret_cast<T*>(items);
                        std::uint32_t n = 0;
                        while (n < count && start_index + n < owner->m_values.size())
                        {
                            dst[n] = owner->m_values[start_index + n];
                            ++n;
                        }
                        *actual = n;
                        return hr_ok;
                    }
                    catch (...)
                    {
                        return catch_to_hresult();
                    }
                }

                static std::int32_t __stdcall replace_all(void* self, void* items, std::uint32_t count) noexcept
                {
                    auto* owner = from_self(self)->m_owner;
                    try
                    {
                        auto* src = reinterpret_cast<T const*>(items);
                        {
                            std::lock_guard lock(owner->m_guard);
                            owner->m_values.clear();
                            owner->m_values.reserve(count);
                            for (std::uint32_t i = 0; i < count; ++i)
                            {
                                owner->m_values.push_back(src[i]);
                            }
                        }
                        owner->fire_changed(collection_change_reset, 0);
                        return hr_ok;
                    }
                    catch (...)
                    {
                        return catch_to_hresult();
                    }
                }
            };

            struct view_iface : inspectable_iface_base<vector_impl<T>>
            {
                using inspectable_iface_base<vector_impl<T>>::from_self;

                static void* const* vtable() noexcept
                {
                    static void* const v[10] =
                    {
                        reinterpret_cast<void*>(&inspectable_iface_base<vector_impl<T>>::qi),
                        reinterpret_cast<void*>(&inspectable_iface_base<vector_impl<T>>::add_ref),
                        reinterpret_cast<void*>(&inspectable_iface_base<vector_impl<T>>::release),
                        reinterpret_cast<void*>(&inspectable_iface_base<vector_impl<T>>::get_iids),
                        reinterpret_cast<void*>(&inspectable_iface_base<vector_impl<T>>::get_class_name),
