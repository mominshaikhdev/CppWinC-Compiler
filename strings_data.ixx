                    return hr_ok;
                }

                static std::int32_t __stdcall index_of(void* self, arg_in_t<T> value, std::uint32_t* index, bool* result) noexcept
                {
                    auto* owner = from_self(self)->m_owner;
                    try
                    {
                        T needle = element::from_abi(value);
                        std::lock_guard lock(owner->m_guard);
                        for (std::size_t i = 0; i < owner->m_values.size(); ++i)
                        {
                            if (owner->m_values[i] == needle)
                            {
                                *index = (std::uint32_t)i;
                                *result = true;
                                return hr_ok;
                            }
                        }
                        *index = 0;
                        *result = false;
                        return hr_ok;
                    }
                    catch (...)
                    {
                        return catch_to_hresult();
                    }
                }

                static std::int32_t __stdcall get_many(void* self, std::uint32_t start_index, void* items, std::uint32_t count, std::uint32_t* actual) noexcept
                {
                    auto* owner = from_self(self)->m_owner;
                    try
                    {
                        std::lock_guard lock(owner->m_guard);
                        if (start_index > owner->m_values.size())
                        {
                            return 0x8000000B; // E_BOUNDS
                        }
                        auto* dst = reinterpret_cast<T*>(items);
                        std::uint32_t n = 0;
                        while (n < count && start_index + n < owner->m_values.size())
                        {
                            dst[n] = owner->m_values[start_index + n];
                            ++n;
                        }
                        *actual = n;
                        return hr_ok;
                    }
                    catch (...)
                    {
                        return catch_to_hresult();
                    }
                }
            };

            struct observable_iface : inspectable_iface_base<vector_impl<T>>
            {
                using inspectable_iface_base<vector_impl<T>>::from_self;

                static void* const* vtable() noexcept
                {
                    static void* const v[8] =
                    {
                        reinterpret_cast<void*>(&inspectable_iface_base<vector_impl<T>>::qi),
                        reinterpret_cast<void*>(&inspectable_iface_base<vector_impl<T>>::add_ref),
                        reinterpret_cast<void*>(&inspectable_iface_base<vector_impl<T>>::release),
                        reinterpret_cast<void*>(&inspectable_iface_base<vector_impl<T>>::get_iids),
                        reinterpret_cast<void*>(&inspectable_iface_base<vector_impl<T>>::get_class_name),
                        reinterpret_cast<void*>(&inspectable_iface_base<vector_impl<T>>::get_trust),
                        reinterpret_cast<void*>(&add_vector_changed),
                        reinterpret_cast<void*>(&remove_vector_changed),
                    };
                    return v;
                }

                static std::int32_t __stdcall add_vector_changed(void* self, void* handler, void* token) noexcept
                {
                    auto* owner = from_self(self)->m_owner;
                    try
                    {
                        *reinterpret_cast<std::int64_t*>(token) = owner->add_vector_changed(handler).value;
                        return hr_ok;
                    }
                    catch (...)
                    {
                        return catch_to_hresult();
                    }
                }

                static std::int32_t __stdcall remove_vector_changed(void* self, std::int64_t token) noexcept
                {
                    auto* owner = from_self(self)->m_owner;
                    owner->remove_vector_changed(winrt::event_token{ token });
                    return hr_ok;
                }
            };

            // IReserveableVector<T>: IInspectable (slots 0-5) + Reserve at
            // slot 6. Capacity-reservation extension of IVector<T>; lets
            // append-heavy callers preallocate storage (std::vector::reserve
            // semantics) so bulk insertion does not repeatedly reallocate.
            struct reserveable_iface : inspectable_iface_base<vector_impl<T>>
            {
                using inspectable_iface_base<vector_impl<T>>::from_self;

                static void* const* vtable() noexcept
                {
                    static void* const v[7] =
                    {
                        reinterpret_cast<void*>(&inspectable_iface_base<vector_impl<T>>::qi),
                        reinterpret_cast<void*>(&inspectable_iface_base<vector_impl<T>>::add_ref),
                        reinterpret_cast<void*>(&inspectable_iface_base<vector_impl<T>>::release),
                        reinterpret_cast<void*>(&inspectable_iface_base<vector_impl<T>>::get_iids),
                        reinterpret_cast<void*>(&inspectable_iface_base<vector_impl<T>>::get_class_name),
                        reinterpret_cast<void*>(&inspectable_iface_base<vector_impl<T>>::get_trust),
                        reinterpret_cast<void*>(&reserve),
                    };
                    return v;
                }

                // Reserve(capacity): grow backing capacity to >= capacity.
                // std::vector::reserve is a no-op when capacity <= current
                // capacity and never shrinks or touches elements, matching the
                // proposal's contract (Size unchanged, elements preserved).
                static std::int32_t __stdcall reserve(void* self, std::uint32_t capacity) noexcept
                {
                    auto* owner = from_self(self)->m_owner;
                    try
                    {
                        std::lock_guard lock(owner->m_guard);
                        owner->m_values.reserve(capacity);
                        return hr_ok;
                    }
                    catch (...)
                    {
                        return catch_to_hresult();
                    }
                }
            };

            iterable_iface m_iterable;
            vector_iface m_vector;
            view_iface m_view;
            observable_iface m_observable;
            reserveable_iface m_reserveable;

            vector_impl()
            {
                m_iterable.m_vtable = iterable_iface::vtable();
                m_iterable.m_owner = this;
                m_vector.m_vtable = vector_iface::vtable();
                m_vector.m_owner = this;
                m_view.m_vtable = view_iface::vtable();
                m_view.m_owner = this;
                m_observable.m_vtable = observable_iface::vtable();
                m_observable.m_owner = this;
                m_reserveable.m_vtable = reserveable_iface::vtable();
                m_reserveable.m_owner = this;
            }

            void* get_abi() noexcept { return &m_observable; }

            void* make_iterator()
            {
                auto snapshot = std::make_shared<std::vector<T>>();
                {
                    std::lock_guard lock(m_guard);
                    *snapshot = m_values;
                }
                return (new vector_iterator_impl<T>(std::move(snapshot)))->get_abi();
            }

            winrt::event_token add_vector_changed(void* handler)
            {
                if (!handler)
                {
                    throw hresult_invalid_argument(0x80070057, L"add_VectorChanged: null handler");
                }
                IUnknown::addref_raw(handler);
                com_ptr<void> keep = com_ptr<void>::attach(handler);
                return m_changed.add([keep](void* sender, void* args) mutable
                {
                    auto* vt = *reinterpret_cast<void* const**>(keep.get());
                    auto invoke = reinterpret_cast<std::int32_t(__stdcall*)(void*, void*, void*)>(vt[3]);
                    invoke(keep.get(), sender, args);
                });
            }

            void remove_vector_changed(winrt::event_token token)
            {
                m_changed.remove(token);
            }

            void fire_changed(std::int32_t change, std::uint32_t index) noexcept
            {
                if (m_changed.size() == 0)
                {
                    return;
                }
                auto args = std::make_unique<vector_changed_args>(change, index);
                m_changed.invoke(&m_observable, args->get_abi());
            }

            std::uint32_t add_ref() noexcept { return m_refs.fetch_add(1, std::memory_order_relaxed) + 1; }

            std::uint32_t release() noexcept
            {
                std::uint32_t remaining = m_refs.fetch_sub(1, std::memory_order_acq_rel) - 1;
                if (remaining == 0)
                {
                    delete this;
                }
                return remaining;
            }

            std::int32_t query_interface(winrt_guid const& iid, void** result) noexcept
            {
                static winrt_guid const iterable_iid = make_generic_iid(guid_iiterable, generic_arg_of<T>);
                static winrt_guid const vector_iid = make_generic_iid(guid_ivector, generic_arg_of<T>);
                static winrt_guid const view_iid = make_generic_iid(guid_ivectorview, generic_arg_of<T>);
                static winrt_guid const observable_iid = make_generic_iid(guid_iobservablevector, generic_arg_of<T>);
                static winrt_guid const reserveable_iid = make_generic_iid(guid_ireserveablevector, generic_arg_of<T>);
                if (iid == winrt_guid::from(iid_iunknown) || iid == winrt_guid::from(iid_iinspectable) || iid == vector_iid)
                {
                    *result = &m_vector;
                    add_ref();
                    return hr_ok;
                }
                if (iid == iterable_iid)
                {
                    *result = &m_iterable;
                    add_ref();
                    return hr_ok;
                }
                if (iid == view_iid)
                {
                    *result = &m_view;
                    add_ref();
                    return hr_ok;
                }
                if (iid == observable_iid)
                {
                    *result = &m_observable;
                    add_ref();
                    return hr_ok;
                }
                if (iid == reserveable_iid)
                {
                    *result = &m_reserveable;
                    add_ref();
                    return hr_ok;
                }
                *result = nullptr;
                return hr_no_interface;
            }

            std::int32_t get_iids(std::uint32_t* count, winrt_guid** iids) noexcept
            {
                static winrt_guid const iterable_iid = make_generic_iid(guid_iiterable, generic_arg_of<T>);
                static winrt_guid const vector_iid = make_generic_iid(guid_ivector, generic_arg_of<T>);
                static winrt_guid const view_iid = make_generic_iid(guid_ivectorview, generic_arg_of<T>);
                static winrt_guid const observable_iid = make_generic_iid(guid_iobservablevector, generic_arg_of<T>);
                static winrt_guid const reserveable_iid = make_generic_iid(guid_ireserveablevector, generic_arg_of<T>);
                static winrt_guid const list[] =
                {
                    winrt_guid::from(iid_iunknown),
                    winrt_guid::from(iid_iinspectable),
                    vector_iid,
                    view_iid,
                    iterable_iid,
                    observable_iid,
                    reserveable_iid,
                };
                *count = 7;
                auto* result = new winrt_guid[7];
                std::copy(std::begin(list), std::end(list), result);
                *iids = result;
                return hr_ok;
            }

            std::int32_t get_class_name(void** name) noexcept
            {
                *name = nullptr;
                return hr_ok;
            }

            std::int32_t get_trust(std::int32_t* trust) noexcept
            {
                *trust = 0;
                return hr_ok;
            }
        };

        // MapChanged event-args object (IMapChangedEventArgs<K>)
        export template <typename K>
        struct map_changed_args
        {
            std::atomic<std::int32_t> m_refs{ 1 };
            std::int32_t m_change = 0; // CollectionChange
            K m_key{};

            struct event_args_iface : inspectable_iface_base<map_changed_args<K>>
            {
                using inspectable_iface_base<map_changed_args<K>>::from_self;

                static void* const* vtable() noexcept
                {
                    static void* const v[8] =
                    {
                        reinterpret_cast<void*>(&inspectable_iface_base<map_changed_args<K>>::qi),
                        reinterpret_cast<void*>(&inspectable_iface_base<map_changed_args<K>>::add_ref),
                        reinterpret_cast<void*>(&inspectable_iface_base<map_changed_args<K>>::release),
                        reinterpret_cast<void*>(&inspectable_iface_base<map_changed_args<K>>::get_iids),
                        reinterpret_cast<void*>(&inspectable_iface_base<map_changed_args<K>>::get_class_name),
                        reinterpret_cast<void*>(&inspectable_iface_base<map_changed_args<K>>::get_trust),
                        reinterpret_cast<void*>(&get_change),
                        reinterpret_cast<void*>(&get_key),
                    };
                    return v;
                }

                static std::int32_t __stdcall get_change(void* self, std::int32_t* value) noexcept
                {
                    *value = from_self(self)->m_owner->m_change;
                    return hr_ok;
                }

                static std::int32_t __stdcall get_key(void* self, put_abi_t<K> out) noexcept
                {
                    auto* owner = from_self(self)->m_owner;
                    try
                    {
                        collection_element<K>::to_abi(out, owner->m_key);
                        return hr_ok;
                    }
                    catch (...)
                    {
                        return catch_to_hresult();
                    }
                }
            };

            event_args_iface m_args;

            map_changed_args(std::int32_t change, K key)
                : m_change(change), m_key(std::move(key))
            {
                m_args.m_vtable = event_args_iface::vtable();
                m_args.m_owner = this;
            }

            void* get_abi() noexcept { return &m_args; }

            std::uint32_t add_ref() noexcept { return m_refs.fetch_add(1, std::memory_order_relaxed) + 1; }

            std::uint32_t release() noexcept
            {
                std::uint32_t remaining = m_refs.fetch_sub(1, std::memory_order_acq_rel) - 1;
                if (remaining == 0)
                {
                    delete this;
                }
                return remaining;
            }

            std::int32_t query_interface(winrt_guid const& iid, void** result) noexcept
            {
                static winrt_guid const value_iid = make_generic_iid(guid_imap_changed_args, generic_arg_of<K>);
                if (iid == winrt_guid::from(iid_iunknown) || iid == winrt_guid::from(iid_iinspectable) || iid == value_iid)
                {
                    *result = &m_args;
                    add_ref();
                    return hr_ok;
                }
                *result = nullptr;
                return hr_no_interface;
            }

            std::int32_t get_iids(std::uint32_t* count, winrt_guid** iids) noexcept
            {
                static winrt_guid const value_iid = make_generic_iid(guid_imap_changed_args, generic_arg_of<K>);
                static winrt_guid const list[] =
                {
                    winrt_guid::from(iid_iunknown),
                    winrt_guid::from(iid_iinspectable),
                    value_iid,
                };
                *count = 3;
                auto* result = new winrt_guid[3];
                std::copy(std::begin(list), std::end(list), result);
                *iids = result;
                return hr_ok;
            }

            std::int32_t get_class_name(void** name) noexcept
            {
                *name = nullptr;
                return hr_ok;
            }

            std::int32_t get_trust(std::int32_t* trust) noexcept
            {
                *trust = 0;
                return hr_ok;
            }
        };

        // a key-value pair handed out by map iterators (IKeyValuePair<K,V>;
        // slots 6 get_Key, 7 get_Value)
        export template <typename K, typename V>
        struct key_value_pair_impl
        {
            std::atomic<std::int32_t> m_refs{ 1 };
            K m_key{};
            V m_value{};

            struct pair_iface : inspectable_iface_base<key_value_pair_impl<K, V>>
            {
                using inspectable_iface_base<key_value_pair_impl<K, V>>::from_self;

                static void* const* vtable() noexcept
                {
                    static void* const v[8] =
                    {
                        reinterpret_cast<void*>(&inspectable_iface_base<key_value_pair_impl<K, V>>::qi),
                        reinterpret_cast<void*>(&inspectable_iface_base<key_value_pair_impl<K, V>>::add_ref),
                        reinterpret_cast<void*>(&inspectable_iface_base<key_value_pair_impl<K, V>>::release),
                        reinterpret_cast<void*>(&inspectable_iface_base<key_value_pair_impl<K, V>>::get_iids),
                        reinterpret_cast<void*>(&inspectable_iface_base<key_value_pair_impl<K, V>>::get_class_name),
                        reinterpret_cast<void*>(&inspectable_iface_base<key_value_pair_impl<K, V>>::get_trust),
                        reinterpret_cast<void*>(&get_key),
                        reinterpret_cast<void*>(&get_value),
                    };
                    return v;
                }

                static std::int32_t __stdcall get_key(void* self, put_abi_t<K> out) noexcept
                {
                    auto* owner = from_self(self)->m_owner;
                    try
                    {
                        collection_element<K>::to_abi(out, owner->m_key);
                        return hr_ok;
                    }
                    catch (...)
                    {
                        return catch_to_hresult();
                    }
                }

                static std::int32_t __stdcall get_value(void* self, put_abi_t<V> out) noexcept
                {
                    auto* owner = from_self(self)->m_owner;
                    try
                    {
                        collection_element<V>::to_abi(out, owner->m_value);
                        return hr_ok;
                    }
                    catch (...)
                    {
                        return catch_to_hresult();
                    }
                }
            };

            pair_iface m_iface;

            key_value_pair_impl(K key, V value)
                : m_key(std::move(key)), m_value(std::move(value))
            {
                m_iface.m_vtable = pair_iface::vtable();
                m_iface.m_owner = this;
            }

            void* get_abi() noexcept { return &m_iface; }

            std::uint32_t add_ref() noexcept { return m_refs.fetch_add(1, std::memory_order_relaxed) + 1; }

            std::uint32_t release() noexcept
            {
                std::uint32_t remaining = m_refs.fetch_sub(1, std::memory_order_acq_rel) - 1;
                if (remaining == 0)
                {
                    delete this;
                }
                return remaining;
            }

            std::int32_t query_interface(winrt_guid const& iid, void** result) noexcept
            {
                static winrt_guid const value_iid = make_generic_iid(guid_ikeyvaluepair, generic_arg_of<K>, generic_arg_of<V>);
                if (iid == winrt_guid::from(iid_iunknown) || iid == winrt_guid::from(iid_iinspectable) || iid == value_iid)
                {
                    *result = &m_iface;
                    add_ref();
                    return hr_ok;
                }
                *result = nullptr;
                return hr_no_interface;
            }

            std::int32_t get_iids(std::uint32_t* count, winrt_guid** iids) noexcept
            {
                static winrt_guid const value_iid = make_generic_iid(guid_ikeyvaluepair, generic_arg_of<K>, generic_arg_of<V>);
                static winrt_guid const list[] =
                {
                    winrt_guid::from(iid_iunknown),
                    winrt_guid::from(iid_iinspectable),
                    value_iid,
                };
                *count = 3;
                auto* result = new winrt_guid[3];
                std::copy(std::begin(list), std::end(list), result);
                *iids = result;
                return hr_ok;
            }

            std::int32_t get_class_name(void** name) noexcept
            {
                *name = nullptr;
                return hr_ok;
            }

            std::int32_t get_trust(std::int32_t* trust) noexcept
            {
                *trust = 0;
                return hr_ok;
            }
        };

        // iterator over a snapshot of a single-threaded map; yields
        // IKeyValuePair<K,V> objects (IIterator<IKeyValuePair<K,V>>)
        export template <typename K, typename V>
        struct map_iterator_impl
        {
            std::atomic<std::int32_t> m_refs{ 1 };
            std::vector<std::pair<K, V>> m_snapshot;
            std::size_t m_position = 0;

            // the IID of IIterator<IKeyValuePair<K,V>>
            static winrt_guid map_iterator_iid() noexcept
            {
                static winrt_guid const kvp_iid = make_generic_iid(guid_ikeyvaluepair, generic_arg_of<K>, generic_arg_of<V>);
                static winrt_guid const value = make_generic_iid(guid_iiterator, generic_arg{ 0, "", kvp_iid, "" });
                return value;
            }

            struct iterator_iface : inspectable_iface_base<map_iterator_impl<K, V>>
            {
                using inspectable_iface_base<map_iterator_impl<K, V>>::from_self;

                static void* const* vtable() noexcept
                {
                    static void* const v[10] =
                    {
                        reinterpret_cast<void*>(&inspectable_iface_base<map_iterator_impl<K, V>>::qi),
                        reinterpret_cast<void*>(&inspectable_iface_base<map_iterator_impl<K, V>>::add_ref),
                        reinterpret_cast<void*>(&inspectable_iface_base<map_iterator_impl<K, V>>::release),
                        reinterpret_cast<void*>(&inspectable_iface_base<map_iterator_impl<K, V>>::get_iids),
                        reinterpret_cast<void*>(&inspectable_iface_base<map_iterator_impl<K, V>>::get_class_name),
                        reinterpret_cast<void*>(&inspectable_iface_base<map_iterator_impl<K, V>>::get_trust),
                        reinterpret_cast<void*>(&get_current),
                        reinterpret_cast<void*>(&get_has_current),
                        reinterpret_cast<void*>(&move_next),
                        reinterpret_cast<void*>(&get_many),
                    };
                    return v;
                }

                static std::int32_t __stdcall get_current(void* self, void* out) noexcept
                {
                    auto* owner = from_self(self)->m_owner;
                    try
                    {
                        if (owner->m_position >= owner->m_snapshot.size())
                        {
                            return 0x8000000B; // E_BOUNDS
                        }
                        auto const& pair = owner->m_snapshot[owner->m_position];
                        auto* kvp = new key_value_pair_impl<K, V>(pair.first, pair.second);
                        *reinterpret_cast<void**>(out) = kvp->get_abi();
                        return hr_ok;
                    }
                    catch (...)
                    {
                        return catch_to_hresult();
                    }
                }

                static std::int32_t __stdcall get_has_current(void* self, bool* value) noexcept
                {
                    auto* owner = from_self(self)->m_owner;
                    *value = owner->m_position < owner->m_snapshot.size();
                    return hr_ok;
                }

                static std::int32_t __stdcall move_next(void* self, bool* value) noexcept
                {
                    auto* owner = from_self(self)->m_owner;
                    if (owner->m_position + 1 < owner->m_snapshot.size())
                    {
                        ++owner->m_position;
                        *value = true;
                    }
                    else
                    {
                        owner->m_position = owner->m_snapshot.size();
                        *value = false;
                    }
                    return hr_ok;
                }

                static std::int32_t __stdcall get_many(void* self, void* items, std::uint32_t count, std::uint32_t* actual) noexcept
                {
                    auto* owner = from_self(self)->m_owner;
                    try
                    {
                        auto* dst = reinterpret_cast<void**>(items);
                        std::uint32_t n = 0;
                        while (n < count && owner->m_position < owner->m_snapshot.size())
                        {
                            auto const& pair = owner->m_snapshot[owner->m_position];
                            auto* kvp = new key_value_pair_impl<K, V>(pair.first, pair.second);
                            dst[n] = kvp->get_abi();
                            ++owner->m_position;
                            ++n;
                        }
                        *actual = n;
                        return hr_ok;
                    }
                    catch (...)
                    {
                        return catch_to_hresult();
                    }
                }
            };

            iterator_iface m_iface;

            explicit map_iterator_impl(std::vector<std::pair<K, V>> snapshot)
                : m_snapshot(std::move(snapshot))
            {
                m_iface.m_vtable = iterator_iface::vtable();
                m_iface.m_owner = this;
            }

            void* get_abi() noexcept { return &m_iface; }

            std::uint32_t add_ref() noexcept { return m_refs.fetch_add(1, std::memory_order_relaxed) + 1; }

            std::uint32_t release() noexcept
            {
                std::uint32_t remaining = m_refs.fetch_sub(1, std::memory_order_acq_rel) - 1;
                if (remaining == 0)
                {
                    delete this;
                }
                return remaining;
            }

            std::int32_t query_interface(winrt_guid const& iid, void** result) noexcept
            {
                static winrt_guid const value_iid = map_iterator_iid();
                if (iid == winrt_guid::from(iid_iunknown) || iid == winrt_guid::from(iid_iinspectable) || iid == value_iid)
                {
                    *result = &m_iface;
                    add_ref();
                    return hr_ok;
                }
                *result = nullptr;
                return hr_no_interface;
            }

            std::int32_t get_iids(std::uint32_t* count, winrt_guid** iids) noexcept
            {
                static winrt_guid const value_iid = map_iterator_iid();
                static winrt_guid const list[] =
                {
                    winrt_guid::from(iid_iunknown),
                    winrt_guid::from(iid_iinspectable),
                    value_iid,
                };
                *count = 3;
                auto* result = new winrt_guid[3];
                std::copy(std::begin(list), std::end(list), result);
                *iids = result;
                return hr_ok;
            }

            std::int32_t get_class_name(void** name) noexcept
            {
                *name = nullptr;
                return hr_ok;
            }

            std::int32_t get_trust(std::int32_t* trust) noexcept
            {
                *trust = 0;
                return hr_ok;
            }
        };

        // the single-threaded map itself: implements IMap<K,V> (slots 6-12),
        // IMapView<K,V> (slots 6-9), IIterable<IKeyValuePair<K,V>> and
        // IObservableMap<K,V> (slots 6-7).
        export template <typename K, typename V>
        struct map_impl
        {
            std::atomic<std::int32_t> m_refs{ 1 };
            std::mutex m_guard;
            std::map<K, V, map_key_less<K>> m_values;
            event<std::function<void(void*, void*)>> m_changed; // MapChanged (sender, args)

            static winrt_guid key_value_pair_iid() noexcept
            {
                static winrt_guid const value = make_generic_iid(guid_ikeyvaluepair, generic_arg_of<K>, generic_arg_of<V>);
                return value;
            }

            // the IID of IIterable<IKeyValuePair<K,V>>: the generic argument
            // is the closed IKeyValuePair interface itself, built by hand
            // (winrt_base cannot name the projected wrapper type)
            static winrt_guid map_iterable_iid() noexcept
            {
                static winrt_guid const value = make_generic_iid(guid_iiterable, generic_arg{ 0, "", key_value_pair_iid(), "" });
                return value;
            }

            static winrt_guid map_iterator_iid() noexcept
            {
                static winrt_guid const value = make_generic_iid(guid_iiterator, generic_arg{ 0, "", key_value_pair_iid(), "" });
                return value;
            }

            struct iterable_iface : inspectable_iface_base<map_impl<K, V>>
            {
                using inspectable_iface_base<map_impl<K, V>>::from_self;

                static void* const* vtable() noexcept
                {
                    static void* const v[7] =
                    {
                        reinterpret_cast<void*>(&inspectable_iface_base<map_impl<K, V>>::qi),
                        reinterpret_cast<void*>(&inspectable_iface_base<map_impl<K, V>>::add_ref),
                        reinterpret_cast<void*>(&inspectable_iface_base<map_impl<K, V>>::release),
                        reinterpret_cast<void*>(&inspectable_iface_base<map_impl<K, V>>::get_iids),
                        reinterpret_cast<void*>(&inspectable_iface_base<map_impl<K, V>>::get_class_name),
                        reinterpret_cast<void*>(&inspectable_iface_base<map_impl<K, V>>::get_trust),
                        reinterpret_cast<void*>(&first),
                    };
                    return v;
                }

                static std::int32_t __stdcall first(void* self, void** result) noexcept
                {
                    auto* owner = from_self(self)->m_owner;
                    try
                    {
                        *result = owner->make_iterator();
                        return hr_ok;
                    }
                    catch (...)
                    {
                        return catch_to_hresult();
                    }
                }
            };

            struct map_iface : inspectable_iface_base<map_impl<K, V>>
            {
                using inspectable_iface_base<map_impl<K, V>>::from_self;

                static void* const* vtable() noexcept
                {
                    static void* const v[13] =
                    {
                        reinterpret_cast<void*>(&inspectable_iface_base<map_impl<K, V>>::qi),
                        reinterpret_cast<void*>(&inspectable_iface_base<map_impl<K, V>>::add_ref),
                        reinterpret_cast<void*>(&inspectable_iface_base<map_impl<K, V>>::release),
                        reinterpret_cast<void*>(&inspectable_iface_base<map_impl<K, V>>::get_iids),
                        reinterpret_cast<void*>(&inspectable_iface_base<map_impl<K, V>>::get_class_name),
                        reinterpret_cast<void*>(&inspectable_iface_base<map_impl<K, V>>::get_trust),
                        reinterpret_cast<void*>(&lookup),
                        reinterpret_cast<void*>(&get_size),
                        reinterpret_cast<void*>(&has_key),
                        reinterpret_cast<void*>(&get_view),
                        reinterpret_cast<void*>(&insert),
                        reinterpret_cast<void*>(&remove),
                        reinterpret_cast<void*>(&clear),
                    };
                    return v;
                }

                static std::int32_t __stdcall lookup(void* self, arg_in_t<K> key, put_abi_t<V> out) noexcept
                {
                    auto* owner = from_self(self)->m_owner;
                    try
                    {
                        K needle = collection_element<K>::from_abi(key);
                        std::lock_guard lock(owner->m_guard);
                        auto it = owner->m_values.find(needle);
                        if (it == owner->m_values.end())
                        {
                            return 0x80070490; // HRESULT_FROM_WIN32(ERROR_NOT_FOUND)
                        }
                        collection_element<V>::to_abi(out, it->second);
                        return hr_ok;
                    }
                    catch (...)
                    {
                        return catch_to_hresult();
                    }
                }

                static std::int32_t __stdcall get_size(void* self, std::uint32_t* value) noexcept
                {
                    auto* owner = from_self(self)->m_owner;
                    std::lock_guard lock(owner->m_guard);
                    *value = (std::uint32_t)owner->m_values.size();
                    return hr_ok;
                }

                static std::int32_t __stdcall has_key(void* self, arg_in_t<K> key, bool* result) noexcept
                {
                    auto* owner = from_self(self)->m_owner;
                    try
                    {
                        K needle = collection_element<K>::from_abi(key);
                        std::lock_guard lock(owner->m_guard);
                        *result = owner->m_values.contains(needle);
                        return hr_ok;
                    }
                    catch (...)
                    {
                        return catch_to_hresult();
                    }
                }

                static std::int32_t __stdcall get_view(void* self, void** result) noexcept
                {
                    auto* owner = from_self(self)->m_owner;
                    *result = &owner->m_mapview;
                    owner->add_ref();
                    return hr_ok;
                }

                static std::int32_t __stdcall insert(void* self, arg_in_t<K> key, arg_in_t<V> value, bool* replaced) noexcept
                {
                    auto* owner = from_self(self)->m_owner;
                    try
                    {
                        K key_value = collection_element<K>::from_abi(key);
                        V value_value = collection_element<V>::from_abi(value);
                        std::int32_t change = collection_change_item_inserted;
                        {
                            std::lock_guard lock(owner->m_guard);
                            auto [it, inserted] = owner->m_values.insert_or_assign(std::move(key_value), std::move(value_value));
                            *replaced = !inserted;
                            if (!inserted)
                            {
                                change = collection_change_item_changed;
                            }
                            key_value = it->first;
                        }
                        owner->fire_changed(change, key_value);
                        return hr_ok;
                    }
                    catch (...)
                    {
                        return catch_to_hresult();
                    }
                }

                static std::int32_t __stdcall remove(void* self, arg_in_t<K> key) noexcept
                {
                    auto* owner = from_self(self)->m_owner;
                    try
                    {
                        K needle = collection_element<K>::from_abi(key);
                        {
                            std::lock_guard lock(owner->m_guard);
                            auto it = owner->m_values.find(needle);
                            if (it == owner->m_values.end())
                            {
                                return 0x8000000C; // E_CHANGED_STATE
                            }
                            needle = it->first;
                            owner->m_values.erase(it);
                        }
                        owner->fire_changed(collection_change_item_removed, needle);
                        return hr_ok;
                    }
                    catch (...)
                    {
                        return catch_to_hresult();
                    }
                }

                static std::int32_t __stdcall clear(void* self) noexcept
                {
                    auto* owner = from_self(self)->m_owner;
                    try
                    {
                        {
                            std::lock_guard lock(owner->m_guard);
                            owner->m_values.clear();
                        }
                        owner->fire_changed(collection_change_reset, K{});
                        return hr_ok;
                    }
                    catch (...)
                    {
                        return catch_to_hresult();
                    }
                }
            };

            struct mapview_iface : inspectable_iface_base<map_impl<K, V>>
            {
                using inspectable_iface_base<map_impl<K, V>>::from_self;

                static void* const* vtable() noexcept
                {
                    static void* const v[10] =
                    {
                        reinterpret_cast<void*>(&inspectable_iface_base<map_impl<K, V>>::qi),
                        reinterpret_cast<void*>(&inspectable_iface_base<map_impl<K, V>>::add_ref),
                        reinterpret_cast<void*>(&inspectable_iface_base<map_impl<K, V>>::release),
                        reinterpret_cast<void*>(&inspectable_iface_base<map_impl<K, V>>::get_iids),
                        reinterpret_cast<void*>(&inspectable_iface_base<map_impl<K, V>>::get_class_name),
                        reinterpret_cast<void*>(&inspectable_iface_base<map_impl<K, V>>::get_trust),
                        reinterpret_cast<void*>(&lookup),
                        reinterpret_cast<void*>(&get_size),
                        reinterpret_cast<void*>(&has_key),
                        reinterpret_cast<void*>(&split),
                    };
                    return v;
                }

                static std::int32_t __stdcall lookup(void* self, arg_in_t<K> key, put_abi_t<V> out) noexcept
                {
                    auto* owner = from_self(self)->m_owner;
                    try
                    {
                        K needle = collection_element<K>::from_abi(key);
                        std::lock_guard lock(owner->m_guard);
                        auto it = owner->m_values.find(needle);
                        if (it == owner->m_values.end())
                        {
                            return 0x80070490; // HRESULT_FROM_WIN32(ERROR_NOT_FOUND)
                        }
                        collection_element<V>::to_abi(out, it->second);
                        return hr_ok;
                    }
                    catch (...)
                    {
                        return catch_to_hresult();
                    }
                }

                static std::int32_t __stdcall get_size(void* self, std::uint32_t* value) noexcept
                {
                    auto* owner = from_self(self)->m_owner;
                    std::lock_guard lock(owner->m_guard);
                    *value = (std::uint32_t)owner->m_values.size();
                    return hr_ok;
                }

                static std::int32_t __stdcall has_key(void* self, arg_in_t<K> key, bool* result) noexcept
                {
                    auto* owner = from_self(self)->m_owner;
                    try
                    {
                        K needle = collection_element<K>::from_abi(key);
                        std::lock_guard lock(owner->m_guard);
                        *result = owner->m_values.contains(needle);
                        return hr_ok;
                    }
                    catch (...)
                    {
                        return catch_to_hresult();
                    }
                }

                static std::int32_t __stdcall split(void* self, void*, void*) noexcept
                {
                    // The projection dispatches Split's out parameters by
                    // value (it passes the wrapper's current m_ptr, which is
                    // null), so there is no addressable slot to write. Split
                    // is effectively unused; leave the views untouched.
                    return hr_ok;
                }
            };

            struct observable_iface : inspectable_iface_base<map_impl<K, V>>
            {
                using inspectable_iface_base<map_impl<K, V>>::from_self;

                static void* const* vtable() noexcept
                {
                    static void* const v[8] =
                    {
                        reinterpret_cast<void*>(&inspectable_iface_base<map_impl<K, V>>::qi),
                        reinterpret_cast<void*>(&inspectable_iface_base<map_impl<K, V>>::add_ref),
                        reinterpret_cast<void*>(&inspectable_iface_base<map_impl<K, V>>::release),
                        reinterpret_cast<void*>(&inspectable_iface_base<map_impl<K, V>>::get_iids),
                        reinterpret_cast<void*>(&inspectable_iface_base<map_impl<K, V>>::get_class_name),
                        reinterpret_cast<void*>(&inspectable_iface_base<map_impl<K, V>>::get_trust),
                        reinterpret_cast<void*>(&add_map_changed),
                        reinterpret_cast<void*>(&remove_map_changed),
                    };
                    return v;
                }

                static std::int32_t __stdcall add_map_changed(void* self, void* handler, void* token) noexcept
                {
                    auto* owner = from_self(self)->m_owner;
                    try
                    {
                        *reinterpret_cast<std::int64_t*>(token) = owner->add_map_changed(handler).value;
                        return hr_ok;
                    }
                    catch (...)
                    {
                        return catch_to_hresult();
                    }
                }

                static std::int32_t __stdcall remove_map_changed(void* self, std::int64_t token) noexcept
                {
                    auto* owner = from_self(self)->m_owner;
                    owner->remove_map_changed(winrt::event_token{ token });
                    return hr_ok;
                }
            };

            iterable_iface m_iterable;
            map_iface m_map;
            mapview_iface m_mapview;
            observable_iface m_observable;

            map_impl()
            {
                m_iterable.m_vtable = iterable_iface::vtable();
                m_iterable.m_owner = this;
                m_map.m_vtable = map_iface::vtable();
                m_map.m_owner = this;
                m_mapview.m_vtable = mapview_iface::vtable();
                m_mapview.m_owner = this;
                m_observable.m_vtable = observable_iface::vtable();
                m_observable.m_owner = this;
            }

            void* get_abi() noexcept { return &m_observable; }

            void* make_iterator()
            {
                std::vector<std::pair<K, V>> snapshot;
                {
                    std::lock_guard lock(m_guard);
                    snapshot.reserve(m_values.size());
                    for (auto const& pair : m_values)
                    {
                        snapshot.emplace_back(pair.first, pair.second);
                    }
                }
                return (new map_iterator_impl<K, V>(std::move(snapshot)))->get_abi();
            }

            winrt::event_token add_map_changed(void* handler)
            {
                if (!handler)
                {
                    throw hresult_invalid_argument(0x80070057, L"add_MapChanged: null handler");
                }
                IUnknown::addref_raw(handler);
                com_ptr<void> keep = com_ptr<void>::attach(handler);
                return m_changed.add([keep](void* sender, void* args) mutable
                {
                    auto* vt = *reinterpret_cast<void* const**>(keep.get());
                    auto invoke = reinterpret_cast<std::int32_t(__stdcall*)(void*, void*, void*)>(vt[3]);
                    invoke(keep.get(), sender, args);
                });
            }

            void remove_map_changed(winrt::event_token token)
            {
                m_changed.remove(token);
            }

            void fire_changed(std::int32_t change, K key) noexcept
            {
                if (m_changed.size() == 0)
                {
                    return;
                }
                auto args = std::make_unique<map_changed_args<K>>(change, std::move(key));
                m_changed.invoke(&m_observable, args->get_abi());
            }

            std::uint32_t add_ref() noexcept { return m_refs.fetch_add(1, std::memory_order_relaxed) + 1; }

            std::uint32_t release() noexcept
            {
                std::uint32_t remaining = m_refs.fetch_sub(1, std::memory_order_acq_rel) - 1;
                if (remaining == 0)
                {
                    delete this;
                }
                return remaining;
            }

            std::int32_t query_interface(winrt_guid const& iid, void** result) noexcept
            {
                static winrt_guid const map_iid = make_generic_iid(guid_imap, generic_arg_of<K>, generic_arg_of<V>);
                static winrt_guid const mapview_iid = make_generic_iid(guid_imapview, generic_arg_of<K>, generic_arg_of<V>);
                static winrt_guid const iterable_iid = map_iterable_iid();
                static winrt_guid const observable_iid = make_generic_iid(guid_iobservablemap, generic_arg_of<K>, generic_arg_of<V>);
                if (iid == winrt_guid::from(iid_iunknown) || iid == winrt_guid::from(iid_iinspectable) || iid == map_iid)
                {
                    *result = &m_map;
                    add_ref();
                    return hr_ok;
                }
                if (iid == iterable_iid)
                {
                    *result = &m_iterable;
                    add_ref();
                    return hr_ok;
                }
                if (iid == mapview_iid)
                {
                    *result = &m_mapview;
                    add_ref();
                    return hr_ok;
                }
                if (iid == observable_iid)
                {
                    *result = &m_observable;
                    add_ref();
                    return hr_ok;
                }
                *result = nullptr;
                return hr_no_interface;
            }

            std::int32_t get_iids(std::uint32_t* count, winrt_guid** iids) noexcept
            {
                static winrt_guid const map_iid = make_generic_iid(guid_imap, generic_arg_of<K>, generic_arg_of<V>);
                static winrt_guid const mapview_iid = make_generic_iid(guid_imapview, generic_arg_of<K>, generic_arg_of<V>);
                static winrt_guid const iterable_iid = map_iterable_iid();
                static winrt_guid const observable_iid = make_generic_iid(guid_iobservablemap, generic_arg_of<K>, generic_arg_of<V>);
                static winrt_guid const list[] =
                {
                    winrt_guid::from(iid_iunknown),
                    winrt_guid::from(iid_iinspectable),
                    map_iid,
                    mapview_iid,
                    iterable_iid,
                    observable_iid,
                };
                *count = 6;
                auto* result = new winrt_guid[6];
                std::copy(std::begin(list), std::end(list), result);
                *iids = result;
                return hr_ok;
            }

            std::int32_t get_class_name(void** name) noexcept
            {
                *name = nullptr;
                return hr_ok;
            }

            std::int32_t get_trust(std::int32_t* trust) noexcept
            {
                *trust = 0;
                return hr_ok;
            }
        };

        // raw factories used by the projection-emitted public functions
        // (single_threaded_vector<T> etc.); the returned pointer has a
        // reference count of one, owned by the caller's wrapper
        export template <typename T>
        void* make_single_threaded_vector()
        {
            return (new vector_impl<T>())->get_abi();
        }

        export template <typename K, typename V>
        void* make_single_threaded_map()
        {
            return (new map_impl<K, V>())->get_abi();
        }

        // IReference<T> pattern GUID (61C17706-2D65-11E0-9AE8-D48564015472)
        export constexpr winrt_guid guid_ireference{ 0x61c17706, 0x2d65, 0x11e0, { 0x9a, 0xe8, 0xd4, 0x85, 0x64, 0x01, 0x54, 0x72 } };

        // Local IReference<T> box for value types the OS PropertyValue
        // statics cannot create (structs like Color, enum classes like
        // FontWeight). Implements IUnknown + IInspectable + get_Value
        // (slot 6) via a hand-rolled vtable; QueryInterface answers the
        // closed generic IID computed from the pattern + argument
        // signature — exactly what consumers (XAML property setters)
        // query.
        export template <typename T>
        struct reference_box
        {
            std::atomic<std::int32_t> m_refs{ 1 };
            T m_value;
            winrt_guid m_iid;
            struct ref_iface;

            std::int32_t add_ref() noexcept { return m_refs.fetch_add(1, std::memory_order_relaxed) + 1; }
            std::int32_t release() noexcept
            {
                auto remaining = m_refs.fetch_sub(1, std::memory_order_acq_rel) - 1;
                if (remaining == 0)
                {
                    delete this;
                }
                return remaining;
            }

            std::int32_t query_interface(winrt_guid const& iid, void** result) noexcept
            {
                if (iid == m_iid || iid == iid_of<winrt::IInspectable> || iid == winrt_guid::from(iid_iunknown))
                {
                    *result = &m_iface;
                    add_ref();
                    return hr_ok;
                }
                *result = nullptr;
                return hr_no_interface;
            }

            struct ref_iface
            {
                void* const* m_vtable = nullptr; // interface pointer = this
                reference_box* m_owner = nullptr;

                static ref_iface* from_self(void* self) noexcept
                {
                    return static_cast<ref_iface*>(self);
                }

                static std::int32_t __stdcall qi(void* self, winrt_guid const& iid, void** result) noexcept
                {
                    return from_self(self)->m_owner->query_interface(winrt_guid::from(iid), result);
                }
                static std::uint32_t __stdcall add_ref_thunk(void* self) noexcept
                {
                    return static_cast<std::uint32_t>(from_self(self)->m_owner->add_ref());
                }
                static std::uint32_t __stdcall release_thunk(void* self) noexcept
                {
                    return static_cast<std::uint32_t>(from_self(self)->m_owner->release());
                }
                static std::int32_t __stdcall get_iids(void* self, std::uint32_t* count, winrt_guid** iids) noexcept
                {
                    *count = 1;
                    auto* result = new winrt_guid[1];
                    *result = from_self(self)->m_owner->m_iid;
                    *iids = result;
                    return hr_ok;
                }
                static std::int32_t __stdcall get_class_name(void* self, void** name) noexcept
                {
                    (void)self;
                    *name = nullptr;
                    return hr_ok;
                }
                static std::int32_t __stdcall get_trust(void* self, std::int32_t* trust) noexcept
                {
                    (void)self;
                    *trust = 0;
                    return hr_ok;
                }
                static std::int32_t __stdcall get_value(void* self, put_abi_t<T> out) noexcept
                {
                    auto* owner = from_self(self)->m_owner;
                    try
                    {
                        collection_element<T>::to_abi(out, owner->m_value);
                        return hr_ok;
                    }
                    catch (...)
                    {
                        return catch_to_hresult();
                    }
                }

                static void* const* vtable() noexcept
                {
                    static void* const v[7] =
                    {
                        reinterpret_cast<void*>(&qi),
                        reinterpret_cast<void*>(&add_ref_thunk),
                        reinterpret_cast<void*>(&release_thunk),
                        reinterpret_cast<void*>(&get_iids),
                        reinterpret_cast<void*>(&get_class_name),
                        reinterpret_cast<void*>(&get_trust),
                        reinterpret_cast<void*>(&get_value),
                    };
                    return v;
                }
            };

            ref_iface m_iface;

            explicit reference_box(T const& value)
                : m_value(value), m_iid(make_generic_iid(guid_ireference, generic_arg_of<T>))
            {
                m_iface.m_vtable = ref_iface::vtable();
                m_iface.m_owner = this;
            }

            void* get_abi() noexcept { return &m_iface; }
        };

        export template <typename T>
        void* make_reference_box(T const& value)
        {
            return (new reference_box<T>(value))->get_abi();
        }
    }

    // string formatting

    export struct hstring_builder
    {
        std::wstring m_data;

        hstring_builder() = default;
        explicit hstring_builder(std::wstring_view value) : m_data(value) {}

        template <typename... Args>
        hstring_builder& append(std::wstring_view fmt, Args&&... args)
        {
            try
            {
                // MSVC's make_wformat_args binds lvalue references; pass the
                // named arguments (lvalues) so rvalue callers compile too
                std::vformat_to(std::back_inserter(m_data), fmt, std::make_wformat_args(args...));
            }
            catch (...)
            {
                m_data.append(fmt);
            }
            return *this;
        }

        hstring_builder& append(wchar_t value) { m_data.push_back(value); return *this; }
        hstring_builder& append(std::wstring_view value) { m_data.append(value); return *this; }
        hstring_builder& append(std::string_view value)
        {
            m_data.append(value.begin(), value.end());
            return *this;
        }

        std::wstring_view view() const noexcept { return m_data; }
        hstring to_hstring() const { return hstring(m_data); }
        explicit operator hstring() const { return hstring(m_data); }
        operator std::wstring_view() const noexcept { return m_data; }
    };

    export template <typename... Args>
    hstring format_hstring(std::wstring_view fmt, Args&&... args)
    {
        hstring_builder builder;
        builder.append(fmt, std::forward<Args>(args)...);
        return builder.to_hstring();
    }

    export inline std::string to_string(std::wstring_view value)
    {
        if (value.empty())
        {
            return {};
        }
        namespace sa = Windows::Win32::STRINGAPISET;
        int size = sa::WideCharToMultiByte(win32::cp_utf8, 0, value.data(), (int)value.size(), nullptr, 0, nullptr, nullptr);
        std::string result(size, '\0');
        if (size)
        {
            sa::WideCharToMultiByte(win32::cp_utf8, 0, value.data(), (int)value.size(), reinterpret_cast<std::int8_t*>(result.data()), size, nullptr, nullptr);
        }
        return result;
    }

    export inline std::wstring to_hstring(std::string_view value)
    {
        if (value.empty())
        {
            return {};
        }
        namespace sa = Windows::Win32::STRINGAPISET;
        int size = sa::MultiByteToWideChar(win32::cp_utf8, 0, reinterpret_cast<const std::int8_t*>(value.data()), (int)value.size(), nullptr, 0);
        std::wstring result(size, L'\0');
        if (size)
        {
            sa::MultiByteToWideChar(win32::cp_utf8, 0, reinterpret_cast<const std::int8_t*>(value.data()), (int)value.size(), result.data(), size);
        }
        return result;
    }

    export inline std::wstring to_hstring(char value) { return std::wstring(1, (wchar_t)value); }
    export inline std::wstring to_hstring(wchar_t value) { return std::wstring(1, value); }
    // Constrained so that string literals (which decay to pointers) don't
    // match this overload via the pointer-to-bool standard conversion and
    // shadow the wstring_view/string_view overloads (matches official
    // cppwinrt, where to_hstring(L"abc") must yield L"abc", not L"true").
    export template <typename T, std::enable_if_t<std::is_same_v<T, bool>, int> = 0>
    std::wstring to_hstring(T value) { return value ? L"true" : L"false"; }
    export inline std::wstring to_hstring(std::int8_t value) { return std::to_wstring((int)value); }
    export inline std::wstring to_hstring(std::uint8_t value) { return std::to_wstring((unsigned)value); }
    export inline std::wstring to_hstring(std::int16_t value) { return std::to_wstring(value); }
    export inline std::wstring to_hstring(std::uint16_t value) { return std::to_wstring(value); }
    export inline std::wstring to_hstring(std::int32_t value) { return std::to_wstring(value); }
    export inline std::wstring to_hstring(std::uint32_t value) { return std::to_wstring(value); }
    export inline std::wstring to_hstring(std::int64_t value) { return std::to_wstring(value); }
    export inline std::wstring to_hstring(std::uint64_t value) { return std::to_wstring(value); }
    export inline std::wstring to_hstring(float value)
    {
        // to_chars with the general format avoids to_wstring's trailing
        // zeros (3.5 -> "3.5", not "3.500000"), matching official cppwinrt.
        char buffer[32];
        auto result = std::to_chars(std::begin(buffer), std::end(buffer), value, std::chars_format::general);
        return std::wstring(buffer, result.ptr);
    }

    export inline std::wstring to_hstring(double value)
    {
        char buffer[32];
        auto result = std::to_chars(std::begin(buffer), std::end(buffer), value, std::chars_format::general);
        return std::wstring(buffer, result.ptr);
    }

    export inline std::wstring to_hstring(winrt_guid const& value)
    {
        wchar_t buffer[40];
        std::swprintf(buffer, 40, L"{%08x-%04x-%04x-%02x%02x-%02x%02x%02x%02x%02x%02x}",
            value.data1, value.data2, value.data3, value.data4[0], value.data4[1],
            value.data4[2], value.data4[3], value.data4[4], value.data4[5],
            value.data4[6], value.data4[7]);
        return buffer;
    }

    export inline std::wstring to_hstring(hresult_error const& error) { return error.message(); }

    export inline std::wstring to_hstring(std::exception const& exception)
    {
        return to_hstring(exception.what());
    }

    export inline std::wstring to_hstring(hstring const& value) { return std::wstring(value.to_view()); }
    export inline std::wstring to_hstring(std::wstring_view value) { return std::wstring(value); }

    // error conversions

    export inline std::int32_t hresult_from_win32(std::uint32_t error) noexcept
    {
        return error ? (std::int32_t)(0x80070000 | (error & 0xFFFF)) : hr_ok;
    }

    export inline std::int32_t hresult_from_nt(std::int32_t status) noexcept
    {
        return (status >= 0) ? hr_ok : (std::int32_t)(0xC0000000u | ((std::uint32_t)status & 0x0FFFFFFF));
    }

    export inline std::int32_t to_hresult(std::exception const& e) noexcept
    {
        if (auto const* he = dynamic_cast<hresult_error const*>(&e))
        {
            return he->value();
        }
        if (auto const* se = dynamic_cast<std::system_error const*>(&e))
        {
            return hresult_from_win32(se->code().value());
        }
        return hr_error;
    }

    export inline void check_win32(std::uint32_t error)
    {
        if (error)
        {
            throw hresult_error(hresult_from_win32(error));
        }
    }

    export inline void check_nt(std::int32_t status)
    {
        if (status < 0)
        {
            throw hresult_error(hresult_from_nt(status));
        }
    }

    export inline void check_hresult_allow_bounds(std::int32_t result)
    {
        if (result < 0)
        {
            throw hresult_error(result);
        }
    }

    // com_ptr completions

    export template <typename T>
    struct com_ptr;

    namespace impl
    {
        template <typename T>
        struct capture_decay
        {
            using type = std::remove_cv_t<T>;
        };

        template <typename T>
        using capture_decay_t = typename capture_decay<T>::type;
    }

    export template <typename T>
    struct is_com_pointer : std::false_type {};

    template <typename T>
    struct is_com_pointer<com_ptr<T>> : std::true_type {};

    export template <typename T>
    inline com_ptr<impl::capture_decay_t<T>> capture(T* value)
    {
        com_ptr<impl::capture_decay_t<T>> result;
        result.copy_from(value);
        return result;
    }

    export template <typename T>
    inline com_ptr<T> capture_to(T** value)
    {
        com_ptr<T> result;
        result.put();
        *value = result.get();
        return result;
    }

    export template <typename T, typename... Args>
    com_ptr<T> try_capture(Args&&... args) noexcept
    {
        try
        {
            return capture<T>(std::forward<Args>(args)...);
        }
        catch (...)
        {
            return nullptr;
        }
    }

    export template <typename T>
    inline void copy_to(T const& value, T& result)
    {
        result = value;
    }

    export template <typename T, typename U>
    inline void copy_to(T const& value, com_ptr<U>& result)
    {
        result = value.template as<U>();
    }

    export template <typename T, typename U>
    inline void copy_to(com_ptr<T> const& value, U** result)
    {
        *result = value ? value.detach() : nullptr;
    }

    // array view (borrowed, non-owning)

    export template <typename T>
    struct array_view
    {
        T* m_data = nullptr;
        std::uint32_t m_size = 0;

        array_view() noexcept = default;
        array_view(T* data, std::uint32_t size) noexcept : m_data(data), m_size(size) {}
        array_view(std::initializer_list<T> values) noexcept : m_data(const_cast<T*>(values.begin())), m_size((std::uint32_t)values.size()) {}

        T* data() const noexcept { return m_data; }
        std::uint32_t size() const noexcept { return m_size; }
        bool empty() const noexcept { return m_size == 0; }

        T& operator[](std::uint32_t index) const noexcept { return m_data[index]; }
        T* begin() const noexcept { return m_data; }
        T* end() const noexcept { return m_data + m_size; }
        T& front() const noexcept { return m_data[0]; }
        T& back() const noexcept { return m_data[m_size - 1]; }

        explicit operator bool() const noexcept { return m_data != nullptr; }
    };

    export template <typename T>
    array_view<T> array_view_from(std::vector<T>& values) noexcept
    {
        return { values.data(), (std::uint32_t)values.size() };
    }

    export template <typename T>
    array_view<T const> array_view_from(std::vector<T> const& values) noexcept
    {
        return { values.data(), (std::uint32_t)values.size() };
    }

    export template <typename T>
    array_view<T> array_view_from(T* data, std::uint32_t size) noexcept
    {
        return { data, size };
    }

    // agile references

    export template <typename T>
    struct agile_ref
    {
        void* m_agile = nullptr; // IAgileReference

        agile_ref() noexcept = default;
        agile_ref(agile_ref const&) = delete;
        agile_ref& operator=(agile_ref const&) = delete;

        agile_ref(agile_ref&& other) noexcept : m_agile(other.m_agile)
        {
            other.m_agile = nullptr;
        }

        agile_ref& operator=(agile_ref&& other) noexcept
        {
            if (this != &other)
            {
                if (m_agile)
                {
                    IUnknown::release_raw(m_agile);
                }
                m_agile = other.m_agile;
                other.m_agile = nullptr;
            }
            return *this;
        }

        explicit agile_ref(T const& value)
        {
            auto* unknown = value.get_abi();
            if (!unknown)
            {
                return;
            }
            namespace com_ns = Windows::Win32::Com;
            void* ref = nullptr;
            winrt_guid iid = iid_of<T>;
            check_hresult(com_ns::RoGetAgileReference(
                com_ns::AgileReferenceOptions::AGILEREFERENCE_DEFAULT,
                &iid, reinterpret_cast<void**>(unknown),
                reinterpret_cast<void***>(&ref)));
            m_agile = ref;
        }

        ~agile_ref()
        {
            if (m_agile)
            {
                IUnknown::release_raw(m_agile);
            }
        }

        T get() const
        {
            if (!m_agile)
            {
                return nullptr;
            }
            // Resolve on the IAgileReference itself: the reference is a
            // marshaler, not the target object, so QueryInterface for the
            // target interface would fail with E_NOINTERFACE.
            // Header-free: IAgileReference's vtable is stable —
            // [0..2] IUnknown, [3] Resolve(REFIID, void**).
            void* result = nullptr;
            auto* vtbl = *reinterpret_cast<void** const*>(m_agile);
            winrt_guid iid = iid_of<T>;
            using resolve_fn = std::int32_t(__stdcall*)(void*, winrt_guid const&, void**);
            check_hresult(reinterpret_cast<resolve_fn>(vtbl[3])(m_agile, iid, &result));
            return T::from_abi(result);
        }

        explicit operator bool() const noexcept { return m_agile != nullptr; }
    };

    export template <typename T>
    agile_ref<T> get_agile_reference(T const& value)
    {
        return agile_ref<T>(value);
    }

    export template <typename T>
    agile_ref<T> make_agile(T const& value)
    {
        return agile_ref<T>(value);
    }

    template <typename T>
    struct agile_ref<T&>
    {
        agile_ref() = delete;
        explicit agile_ref(T&) = delete;
        agile_ref(agile_ref const&) = delete;
        agile_ref& operator=(agile_ref const&) = delete;
    };

    // event revokers

    export struct auto_revoke_t
    {
    };

    export constexpr auto_revoke_t auto_revoke{};

    export template <typename I>
    struct event_revoker
    {
        using remove_fn = void (I::*)(winrt::event_token const&) const;

        I* m_interface = nullptr;
        remove_fn m_remove = nullptr;
        winrt::event_token m_token{};

        event_revoker() noexcept = default;
        event_revoker(I* iface, remove_fn remove, winrt::event_token const& token) noexcept
            : m_interface(iface), m_remove(remove), m_token(token)
        {
        }

        event_revoker(event_revoker&& other) noexcept
            : m_interface(other.m_interface), m_remove(other.m_remove), m_token(other.m_token)
        {
            other.m_interface = nullptr;
            other.m_remove = nullptr;
            other.m_token = {};
        }

        event_revoker& operator=(event_revoker&& other) noexcept
        {
            if (this != &other)
            {
                revoke();
                m_interface = other.m_interface;
                m_remove = other.m_remove;
                m_token = other.m_token;
                other.m_interface = nullptr;
                other.m_remove = nullptr;
                other.m_token = {};
            }
            return *this;
        }

        event_revoker(event_revoker const&) = delete;
        event_revoker& operator=(event_revoker const&) = delete;

        ~event_revoker()
        {
            revoke();
        }

        void revoke() noexcept
        {
            if (m_interface)
            {
                (m_interface->*m_remove)(m_token);
                m_interface = nullptr;
                m_remove = nullptr;
                m_token = {};
            }
        }

        explicit operator bool() const noexcept { return m_interface != nullptr; }
    };

    // synchronization primitives

    // synchronization primitives. std-based (header-free): the SRW/condvar
    // Win32 APIs may not be among the project's needed modules, and
    // std::shared_mutex/condition_variable_any give identical semantics.
    export struct slim_mutex
    {
        std::shared_mutex m_lock;

        void lock() noexcept { m_lock.lock(); }
        void unlock() noexcept { m_lock.unlock(); }
        bool try_lock() noexcept { return m_lock.try_lock(); }
    };

    export struct slim_lock_guard
    {
        slim_mutex& m_mutex;

        explicit slim_lock_guard(slim_mutex& mutex) noexcept : m_mutex(mutex)
        {
            m_mutex.lock();
        }

        ~slim_lock_guard()
        {
            m_mutex.unlock();
        }

        slim_lock_guard(slim_lock_guard const&) = delete;
        slim_lock_guard& operator=(slim_lock_guard const&) = delete;
    };

    export struct slim_shared_lock_guard
    {
        slim_mutex& m_mutex;

        explicit slim_shared_lock_guard(slim_mutex& mutex) noexcept : m_mutex(mutex)
        {
            mutex.m_lock.lock_shared();
        }

        ~slim_shared_lock_guard()
        {
            m_mutex.m_lock.unlock_shared();
        }

        slim_shared_lock_guard(slim_shared_lock_guard const&) = delete;
        slim_shared_lock_guard& operator=(slim_shared_lock_guard const&) = delete;
    };

    export struct slim_condition_variable
    {
        std::condition_variable_any m_cond;

        template <typename Lock>
        void wait(Lock& lock) noexcept { m_cond.wait(lock); }

        template <typename Lock>
        bool wait_for(Lock& lock, std::chrono::milliseconds timeout) noexcept
        {
            return m_cond.wait_for(lock, timeout) == std::cv_status::no_timeout;
        }

        void notify_one() noexcept { m_cond.notify_one(); }
        void notify_all() noexcept { m_cond.notify_all(); }
    };

    // Win32 handle RAII (header-free: HANDLE = void*, CloseHandle comes
    // from the winversec-projected Foundation module)
    // Exported inline variables in MSVC named modules can end up with no
    // emitted varent (LNK2001 even though every use is in-module). A plain
    // exported function always emits in the module unit's obj, so the handle
    // sentinel is a function instead of a variable.
    inline void* invalid_handle_value() noexcept
    {
        return reinterpret_cast<void*>(static_cast<std::intptr_t>(-1));
    }

    export struct handle_type
    {
        void* m_value = invalid_handle_value();

        handle_type() noexcept = default;
        handle_type(std::nullptr_t) noexcept {}
        explicit handle_type(void* value) noexcept : m_value(value) {}
        handle_type(handle_type&& other) noexcept : m_value(other.m_value)
        {
            other.m_value = invalid_handle_value();
        }

        handle_type& operator=(handle_type&& other) noexcept
        {
            if (this != &other)
            {
                close();
                m_value = other.m_value;
                other.m_value = invalid_handle_value();
            }
            return *this;
        }

        handle_type(handle_type const&) = delete;
        handle_type& operator=(handle_type const&) = delete;

        ~handle_type()
        {
            close();
        }

        void close() noexcept
        {
            if (m_value != invalid_handle_value() && m_value != nullptr)
            {
                Windows::Win32::Foundation::CloseHandle(m_value);
                m_value = invalid_handle_value();
            }
        }

        void* get() const noexcept { return m_value; }
        void** put() noexcept
        {
            close();
            return &m_value;
        }

        void* detach() noexcept
        {
            void* result = m_value;
            m_value = invalid_handle_value();
            return result;
        }

        static handle_type attach(void* value) noexcept
        {
            handle_type result;
            result.m_value = value;
            return result;
        }

        explicit operator bool() const noexcept { return m_value != invalid_handle_value() && m_value != nullptr; }
        void swap(handle_type& other) noexcept { std::swap(m_value, other.m_value); }
    };

    // chrono

    export struct clock
    {
        using duration = std::chrono::duration<std::int64_t, std::ratio<1, 10'000'000>>;
        using rep = duration::rep;
        using period = duration::period;
        using time_point = std::chrono::time_point<clock>;
        static constexpr bool is_steady = false;

        static time_point now() noexcept
        {
            namespace sys_ns = Windows::Win32::SYSINFOAPI;
            using file_time_abi = Windows::Win32::LMACCESS::FILETIME;
            file_time_abi ft{};
            sys_ns::GetSystemTimePreciseAsFileTime(&ft);
            return time_point(duration(((std::int64_t)ft.dwHighDateTime << 32) | ft.dwLowDateTime));
        }
    };

    export using file_time = clock::time_point;

    export inline file_time from_file_time(Windows::Win32::LMACCESS::FILETIME const& value) noexcept
    {
        return file_time(clock::duration(((std::int64_t)value.dwHighDateTime << 32) | value.dwLowDateTime));
    }

    export inline Windows::Win32::LMACCESS::FILETIME to_file_time(file_time const& value) noexcept
    {
        auto ticks = value.time_since_epoch().count();
        Windows::Win32::LMACCESS::FILETIME result{};
        result.dwLowDateTime = (std::uint32_t)(ticks & 0xFFFFFFFF);
        result.dwHighDateTime = (std::uint32_t)(ticks >> 32);
        return result;
    }

    export inline file_time from_sys(std::chrono::system_clock::time_point const& value) noexcept
    {
        // Windows FILETIME epoch is 1601-01-01; the Unix epoch is 11644473600 seconds later.
        static constexpr std::chrono::seconds epoch_offset{ 11644473600 };
        return file_time(std::chrono::duration_cast<clock::duration>(value.time_since_epoch() + epoch_offset));
    }

    export inline std::chrono::system_clock::time_point to_sys(file_time const& value) noexcept
    {
        static constexpr std::chrono::seconds epoch_offset{ 11644473600 };
        return std::chrono::system_clock::time_point(
            std::chrono::duration_cast<std::chrono::system_clock::duration>(value.time_since_epoch() - epoch_offset));
    }

    // boxing (property value creation / inspection via the raw ABI)

    export inline void* box_value(bool value)
    {
        return impl::box_value_impl<bool>(value);
    }

    export inline void* box_value(std::int8_t value) { return impl::box_value_impl<std::int8_t>(value); }
    export inline void* box_value(std::uint8_t value) { return impl::box_value_impl<std::uint8_t>(value); }
    export inline void* box_value(std::int16_t value) { return impl::box_value_impl<std::int16_t>(value); }
    export inline void* box_value(std::uint16_t value) { return impl::box_value_impl<std::uint16_t>(value); }
    export inline void* box_value(std::int32_t value) { return impl::box_value_impl<std::int32_t>(value); }
    export inline void* box_value(std::uint32_t value) { return impl::box_value_impl<std::uint32_t>(value); }
    export inline void* box_value(std::int64_t value) { return impl::box_value_impl<std::int64_t>(value); }
    export inline void* box_value(std::uint64_t value) { return impl::box_value_impl<std::uint64_t>(value); }
    export inline void* box_value(float value) { return impl::box_value_impl<float>(value); }
    export inline void* box_value(double value) { return impl::box_value_impl<double>(value); }
    export inline void* box_value(char16_t value) { return impl::box_value_impl<char16_t>(value); }
    export inline void* box_value(hstring const& value) { return impl::box_value_impl<hstring>(value); }
    // Literal pointers must never reach box_value(bool) through the
    // pointer-to-bool standard conversion (a boxed "true" object displays
    // as the runtime class name in content presenters).
    export inline void* box_value(wchar_t const* value) { return impl::box_value_impl<hstring>(hstring(value)); }
    export inline void* box_value(char const* value) { return impl::box_value_impl<hstring>(hstring(winrt::to_hstring(std::string_view(value)))); }
    export inline void* box_value(winrt_guid const& value) { return impl::box_value_impl<winrt_guid>(value); }

    // unboxing (inspect a boxed value through IPropertyValue)

    // Windows.Foundation.IPropertyValue, resolved by IID; the projection's
    // IInspectable never exposes it directly, so the vtable is walked from
    // the boxed object itself (slots 8..20 are GetUInt8..GetGuid).

    namespace impl
    {
        inline void* property_value_interface(void* inspectable)
        {
            if (!inspectable)
            {
                throw winrt::hresult_invalid_argument(0x80070057, L"unbox_value: null value");
            }
            static constexpr winrt_guid iid_property_value{ 0x4BD682DD, 0x7554, 0x40E9, { 0x9A, 0x9B, 0x82, 0x65, 0x4E, 0xDE, 0x7E, 0x62 } };
            void* result = nullptr;
            winrt::check_hresult(impl::query_interface(inspectable, iid_property_value, &result));
            if (!result)
            {
                throw winrt::hresult_invalid_argument(0x80070057, L"unbox_value: value is not boxed");
            }
            return result;
        }
    }

    export template <typename T>
    T unbox_value(winrt::IInspectable const& value)
    {
        void* pv = impl::property_value_interface(value.m_ptr);
        auto* vt = *reinterpret_cast<void* const**>(pv);
        // the canonical runtime validates the boxed type before the getter:
        // a mismatch throws hresult_invalid_argument instead of surfacing the
        // OS getter's E_ILLEGAL_METHOD_CALL. PropertyType: Empty 0, UInt8 1,
        // Int16 2, UInt16 3, Int32 4, UInt32 5, Int64 6, UInt64 7, Single 8,
        // Double 9, Char16 10, Boolean 11, String 12, Guid 16.
        using type_fn_t = std::int32_t(__stdcall*)(void*, std::int32_t*);
        std::int32_t boxed_type = 0;
        winrt::check_hresult(reinterpret_cast<type_fn_t>(vt[6])(pv, &boxed_type));
        std::int32_t expected = 0;
        if constexpr (std::is_same_v<T, bool>)
        {
            expected = 11;
        }
        else if constexpr (std::is_same_v<T, std::int8_t> || std::is_same_v<T, std::uint8_t>)
        {
            expected = 1;
        }
        else if constexpr (std::is_same_v<T, std::int16_t>)
        {
            expected = 2;
        }
        else if constexpr (std::is_same_v<T, std::uint16_t>)
        {
            expected = 3;
        }
        else if constexpr (std::is_same_v<T, std::int32_t>)
        {
            expected = 4;
        }
        else if constexpr (std::is_same_v<T, std::uint32_t>)
        {
            expected = 5;
        }
        else if constexpr (std::is_same_v<T, std::int64_t>)
        {
            expected = 6;
        }
        else if constexpr (std::is_same_v<T, std::uint64_t>)
        {
            expected = 7;
        }
        else if constexpr (std::is_same_v<T, float>)
        {
            expected = 8;
        }
        else if constexpr (std::is_same_v<T, double>)
        {
            expected = 9;
        }
        else if constexpr (std::is_same_v<T, char16_t>)
        {
            expected = 10;
        }
        else if constexpr (std::is_same_v<T, hstring>)
        {
            expected = 12;
        }
        else if constexpr (std::is_same_v<T, winrt_guid>)
        {
            expected = 16;
        }
        if (boxed_type != expected)
        {
            throw winrt::hresult_invalid_argument(0x80070057, L"unbox_value: type mismatch");
        }
        if constexpr (std::is_same_v<T, bool>)
        {
            using fn_t = std::int32_t(__stdcall*)(void*, std::uint8_t*);
            std::uint8_t out = 0;
            winrt::check_hresult(reinterpret_cast<fn_t>(vt[18])(pv, &out));
            return out != 0;
        }
        else if constexpr (std::is_same_v<T, std::int8_t>)
        {
            using fn_t = std::int32_t(__stdcall*)(void*, std::uint8_t*);
            std::uint8_t out = 0;
            winrt::check_hresult(reinterpret_cast<fn_t>(vt[8])(pv, &out));
            return static_cast<std::int8_t>(out);
        }
        else if constexpr (std::is_same_v<T, std::uint8_t>)
        {
            using fn_t = std::int32_t(__stdcall*)(void*, std::uint8_t*);
            std::uint8_t out = 0;
            winrt::check_hresult(reinterpret_cast<fn_t>(vt[8])(pv, &out));
            return out;
        }
        else if constexpr (std::is_same_v<T, std::int16_t>)
        {
            using fn_t = std::int32_t(__stdcall*)(void*, std::int16_t*);
            std::int16_t out = 0;
            winrt::check_hresult(reinterpret_cast<fn_t>(vt[9])(pv, &out));
            return out;
        }
        else if constexpr (std::is_same_v<T, std::uint16_t>)
        {
            using fn_t = std::int32_t(__stdcall*)(void*, std::uint16_t*);
            std::uint16_t out = 0;
            winrt::check_hresult(reinterpret_cast<fn_t>(vt[10])(pv, &out));
            return out;
        }
        else if constexpr (std::is_same_v<T, std::int32_t>)
        {
            using fn_t = std::int32_t(__stdcall*)(void*, std::int32_t*);
            std::int32_t out = 0;
            winrt::check_hresult(reinterpret_cast<fn_t>(vt[11])(pv, &out));
            return out;
        }
        else if constexpr (std::is_same_v<T, std::uint32_t>)
        {
            using fn_t = std::int32_t(__stdcall*)(void*, std::uint32_t*);
            std::uint32_t out = 0;
            winrt::check_hresult(reinterpret_cast<fn_t>(vt[12])(pv, &out));
            return out;
        }
        else if constexpr (std::is_same_v<T, std::int64_t>)
        {
            using fn_t = std::int32_t(__stdcall*)(void*, std::int64_t*);
            std::int64_t out = 0;
            winrt::check_hresult(reinterpret_cast<fn_t>(vt[13])(pv, &out));
            return out;
        }
        else if constexpr (std::is_same_v<T, std::uint64_t>)
        {
            using fn_t = std::int32_t(__stdcall*)(void*, std::uint64_t*);
            std::uint64_t out = 0;
            winrt::check_hresult(reinterpret_cast<fn_t>(vt[14])(pv, &out));
            return out;
        }
        else if constexpr (std::is_same_v<T, float>)
        {
            using fn_t = std::int32_t(__stdcall*)(void*, float*);
            float out = 0;
            winrt::check_hresult(reinterpret_cast<fn_t>(vt[15])(pv, &out));
            return out;
        }
        else if constexpr (std::is_same_v<T, double>)
        {
            using fn_t = std::int32_t(__stdcall*)(void*, double*);
            double out = 0;
            winrt::check_hresult(reinterpret_cast<fn_t>(vt[16])(pv, &out));
            return out;
        }
        else if constexpr (std::is_same_v<T, char16_t>)
        {
            using fn_t = std::int32_t(__stdcall*)(void*, wchar_t*);
            wchar_t out = 0;
            winrt::check_hresult(reinterpret_cast<fn_t>(vt[17])(pv, &out));
            return static_cast<char16_t>(out);
        }
        else if constexpr (std::is_same_v<T, hstring>)
        {
            using fn_t = std::int32_t(__stdcall*)(void*, void**);
            void* out = nullptr;
            winrt::check_hresult(reinterpret_cast<fn_t>(vt[19])(pv, &out));
            return hstring::from_abi(out);
        }
        else if constexpr (std::is_same_v<T, winrt_guid>)
        {
            // Header-free: PropertyValue hands back an ABI GUID with the
            // same memory shape as winrt_guid — reinterpret through the
            // identical field layout.
            struct abi_guid { std::uint32_t Data1; std::uint16_t Data2; std::uint16_t Data3; std::uint8_t Data4[8]; };
            static_assert(sizeof(abi_guid) == sizeof(winrt_guid));
            using fn_t = std::int32_t(__stdcall*)(void*, abi_guid*);
            abi_guid out{};
            winrt::check_hresult(reinterpret_cast<fn_t>(vt[20])(pv, &out));
            return winrt_guid{ out.Data1, out.Data2, out.Data3, { out.Data4[0], out.Data4[1], out.Data4[2], out.Data4[3], out.Data4[4], out.Data4[5], out.Data4[6], out.Data4[7] } };
        }
        else
        {
            static_assert(std::is_same_v<T, bool>, "unbox_value: unsupported type");
        }
    }

    export template <typename T>
    T unbox_value_or(winrt::IInspectable const& value, T const& default_value)
    {
        if (!value)
        {
            return default_value;
        }
        try
        {
            return unbox_value<T>(value);
        }
        catch (hresult_error const&)
        {
            return default_value;
        }
    }

        )cppwinc");
        s.append(cppwinc::strings::base_async_ixx);
        s.append(R"cppwinc(        // resumption on the thread pool, the originating apartment, or a
        // dispatcher queue

        export struct resume_background_awaiter
        {
            bool await_ready() const noexcept
            {
                return false;
            }

            bool await_suspend(std::coroutine_handle<void> handle)
            {
                // std::thread keeps this header-free; the Win32 threadpool
                // module is not part of every project's closure.
                std::thread([handle] { handle.resume(); }).detach();
                return true;
            }

            void await_resume() const noexcept
            {
            }
        };

        export inline resume_background_awaiter resume_background() noexcept
        {
            return {};
        }

        struct context_callback_args
        {
            void* address = nullptr;
        };

        // Header-free COM callback contract (winuic philosophy: no SDK
        // headers). IContextCallback's vtable is stable:
        //   [0..2] IUnknown, [3] ContextCallback(pfn, ComCallData*, REFIID,
        //          int iMethod, void*)
        // IIDs verified against the Windows SDK / CppWinRT:
        //   IContextCallback                        000001da-0000-0000-C000-000000000046
        //   ICallbackWithNoReentrancyToApplicationSTA 0A299774-3E4E-FC42-1D9D-72CEE105CA57
        inline constexpr winrt_guid iid_icontext_callback
        {
            0x000001da, 0x0000, 0x0000, { 0xC0, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x46 }
        };
        inline constexpr winrt_guid iid_callback_no_reentrancy_asta
        {
            0x0A299774, 0x3E4E, 0xFC42, { 0x1D, 0x9D, 0x72, 0xCE, 0xE1, 0x05, 0xCA, 0x57 }
        };

        // com_callback_args mirrors ComCallData exactly: two reserved
        // DWORDs then pUserDefined — the callback reads args->data at
        // offset 8, matching the OS contract (see CppWinRT com_callback_args).
        struct com_callback_args
        {
            std::uint32_t reserved1 = 0;
            std::uint32_t reserved2 = 0;
            void* data = nullptr;
        };

        inline std::int32_t __stdcall resume_context_callback(com_callback_args* args) noexcept
        {
            std::coroutine_handle<void>::from_address(args->data).resume();
            return hr_ok;
        }

        export struct resume_apartment_awaiter
        {
            bool await_ready() const noexcept
            {
                return false;
            }

            bool await_suspend(std::coroutine_handle<void> handle)
            {
                // CoGetObjectContext(REFIID, void**) — projected header-free
                // from winversec metadata; the iid is passed by pointer to
                // the raw ABI.
                void* context = nullptr;
                namespace com_ns = Windows::Win32::Com;
                std::int32_t hr = com_ns::CoGetObjectContext(
                    &const_cast<winrt_guid&>(iid_icontext_callback), &context);
                if (hr < 0 || !context)
                {
                    return false;
                }
                auto* vtbl = *reinterpret_cast<void** const*>(context);
                using ctx_fn = std::int32_t(__stdcall*)(void*, std::int32_t(__stdcall*)(com_callback_args*),
                    com_callback_args*, winrt_guid const&, int, void*);
                com_callback_args args{ 0, 0, handle.address() };
                // iMethod 5 = ICallbackWithNoReentrancyToApplicationSTA (matches CppWinRT)
                hr = reinterpret_cast<ctx_fn>(vtbl[3])(context, resume_context_callback, &args,
                    iid_callback_no_reentrancy_asta, 5, nullptr);
                // release the context object (slot 2 = Release)
                reinterpret_cast<std::uint32_t(__stdcall*)(void*)>(vtbl[2])(context);
                return hr >= 0;
            }

            void await_resume() const noexcept
            {
            }
        };

        export inline resume_apartment_awaiter resume_apartment() noexcept
        {
            return {};
        }

        // COM object wrapping a zero-argument action (DispatcherQueueHandler)

        export inline std::int32_t to_hresult(std::exception_ptr const& error = std::current_exception()) noexcept
        {
            try
            {
                std::rethrow_exception(error);
            }
            catch (winrt::hresult_error const& ex)
            {
                return ex.value();
            }
            catch (std::bad_alloc const&)
            {
                return hr_out_of_memory;
            }
            catch (...)
            {
                return hr_error;
            }
        }

        struct action_delegate : com_handler_base<action_delegate>
        {
            std::function<void()> m_action;

            explicit action_delegate(std::coroutine_handle<void> handle)
                : m_action([address = handle.address()]() { std::coroutine_handle<void>::from_address(address).resume(); })
            {
            }

            static std::int32_t __stdcall invoke(void* self) noexcept
            {
                auto* me = static_cast<action_delegate*>(self);
                try
                {
                    me->m_action();
                }
                catch (...)
                {
                    return to_hresult();
                }
                return hr_ok;
            }
        };

        export template <typename Queue, typename Priority>
        struct resume_foreground_awaiter
        {
            Queue m_queue;
            Priority m_priority;

            resume_foreground_awaiter(Queue queue, Priority priority) noexcept
                : m_queue(queue), m_priority(priority)
            {
            }

            bool await_ready() const noexcept
            {
                return false;
            }

            bool await_suspend(std::coroutine_handle<void> handle)
            {
                auto* action = new action_delegate(handle);
                auto handler = Queue::handler_type::from_abi(action);
                if (m_queue.TryEnqueue(m_priority, handler))
                {
                    return true;
                }
                return false;
            }

            void await_resume() const noexcept
            {
            }
        };

        export template <typename Queue>
        struct resume_foreground_simple_awaiter
        {
            Queue m_queue;

            explicit resume_foreground_simple_awaiter(Queue queue) noexcept : m_queue(queue) {}

            bool await_ready() const noexcept
            {
                return false;
            }

            bool await_suspend(std::coroutine_handle<void> handle)
            {
                auto* action = new action_delegate(handle);
                auto handler = Queue::handler_type::from_abi(action);
                if (m_queue.TryEnqueue(handler))
                {
                    return true;
                }
                return false;
            }

            void await_resume() const noexcept
            {
            }
        };

        export template <typename Queue, typename Priority>
        resume_foreground_awaiter<Queue, Priority> resume_foreground(Queue const& queue, Priority priority) noexcept
        {
            return { queue, priority };
        }

        export template <typename Queue>
        resume_foreground_simple_awaiter<Queue> resume_foreground(Queue const& queue) noexcept
        {
            return { queue };
        }

        export inline bool is_sta_thread() noexcept
        {
            // APTTYPE is a plain C enum the winmd does not carry; its
            // documented values are MTA=0, STA=1, NA=3, MAINSTA=2.
            std::int32_t type = 0;
            std::int32_t qualifier = 0;
            return Windows::Win32::Com::CoGetApartmentType(reinterpret_cast<void**>(&type),
                reinterpret_cast<void**>(&qualifier)) >= 0 && (type == 1 || type == 2);
        }
    }

    // fire-and-forget coroutine. An unhandled exception terminates the
    // process with the failure code so no error is silently swallowed.

    export struct fire_and_forget
    {
        fire_and_forget() noexcept = default;

        struct promise_type
        {
            fire_and_forget get_return_object() noexcept
            {
                return {};
            }

            std::suspend_never initial_suspend() const noexcept
            {
                return {};
            }

            std::suspend_never final_suspend() const noexcept
            {
                return {};
            }

            void return_void() const noexcept
            {
            }

            void unhandled_exception() const noexcept
            {
                std::int32_t hr = impl::to_hresult();
                if (hr < 0)
                {
                    Windows::Win32::ROERRORAPI::RoFailFastWithErrorContext(hr);
                }
            }
        };
    };

    // common get_abi helpers

    export template <typename T>
    void* const* get_abi(com_ptr<T> const& ptr) noexcept
    {
        return ptr.get_abi();
    }

    export template <typename T>
    void* const* get_abi(com_ptr<void> const& ptr) noexcept
    {
        return ptr.get_abi();
    }

    export template <typename T>
    void* get_abi(T const& value) noexcept
    {
        return value.get_abi();
    }

    // component authoring helpers
    //
    // Everything a component author needs beyond the consumer runtime:
    // opt-out markers, interface-to-impl downcasts, implementation object
    // creation (make/make_self), cached activation-factory access, deferrable
    // event args, and a custom thread pool for coroutine offload. All of it
    // is projection-free: these templates operate on the ABI layer only, so
    // winrt_base stays usable as a standalone module.

    // markers a component class can derive from to opt out of agile/weak
    // support (mirrors the canonical runtime's opt-outs)
    export struct non_agile
    {
    };

    export struct no_weak_ref
    {
    };

    export template <typename T>
    T check_pointer(T pointer)
    {
        if (!pointer)
        {
            throw hresult_error(hr_error, L"null pointer");
        }
        return pointer;
    }

    export inline void throw_last_error()
    {
        throw hresult_error(hresult_from_win32(Windows::Win32::ERRHANDLINGAPI::GetLastError()), L"win32 error");
    }

    // downcast a projected interface to the owning implementation object.
    // The impl class D derives (directly or transitively) from
    // interface_impl_base<D, I>, whose first member is the vtable pointer;
    // the ABI pointer therefore aliases the interface_impl_base object and
    // its m_owner back-pointer reaches D.

    export template <typename D, typename I>
    D* get_self(I const& from) noexcept
    {
        return static_cast<impl::interface_impl_base<D, I>*>(from.get_abi())->m_owner;
    }

    export template <typename D, typename I>
    D* get_self(com_ptr<I> const& from) noexcept
    {
        return static_cast<D*>(from.get());
    }

    // heap-allocate an implementation object. D derives from implements<D, ...>
    // so the object owns itself: com_object starts at one reference, and
    // implements::Release deletes at zero. The returned com_ptr takes that
    // initial reference.

    export template <typename D, typename... Args>
    com_ptr<D> make_self(Args&&... args)
    {
        return com_ptr<D>::attach(new D(std::forward<Args>(args)...));
    }

    // create an implementation object and project it as its default interface.
    // D must name its default interface via implements_type::default_interface
    // (the implements base sets that up automatically).

    export template <typename D, typename... Args>
    auto make(Args&&... args)
    {
        using I = typename D::implements_type::default_interface;
        auto self = make_self<D>(std::forward<Args>(args)...);
        void* abi = static_cast<impl::interface_impl_base<D, I>*>(self.get())->get_abi();
        self.detach();
        return I::from_abi(abi);
    }

    // cached activation-factory access for static (factory) members.
    // call_factory<Class, Interface>(callback) resolves the activation
    // factory for Class once, caches it, and invokes the callback with the
    // factory projected as Interface.

    namespace impl
    {
        export struct factory_cache
        {
            std::atomic<void*> m_factory{ nullptr };

            void* get(std::wstring_view class_name)
            {
                void* result = m_factory.load(std::memory_order_acquire);
                if (!result)
                {
                    void* fresh = impl::get_factory(class_name);
                    void* expected = nullptr;
                    if (m_factory.compare_exchange_strong(expected, fresh))
                    {
                        result = fresh;
                    }
                    else
                    {
                        IUnknown::release_raw(fresh);
                        result = expected;
                    }
                }
                return result;
            }
        };
    }

    export template <typename Class, typename Interface, typename F>
    auto call_factory(F&& callback)
    {
        static impl::factory_cache cache;
        void* raw = cache.get(Class::class_name());
        Interface factory = Interface::from_abi(raw);
        return callback(factory);
    }

    // deferrable event args: the standard event-args base for components
    // that want GetDeferral support. The deferral is a hand-rolled IDeferral
    // COM object (IID d6269732-3b7f-46a7-b40b-4fdca2a2c693, Complete at
    // vtable slot 3) so winrt_base needs no projection dependency; the
    // template parameter Deferral is the projected Windows.Foundation.Deferral
    // type supplied by the component module that imports the projection.

    namespace impl
    {
        export constexpr winrt_guid iid_of_deferral{ 0xd6269732, 0x3b7f, 0x46a7, { 0xb4, 0x0b, 0x4f, 0xdc, 0xa2, 0xa2, 0xc6, 0x93 } };

        export inline void resume_background(std::coroutine_handle<> handle) noexcept
        {
            // std::thread keeps this header-free; see resume_background_awaiter.
            std::thread([handle] { handle(); }).detach();
        }

        export template <typename D>
        struct deferral_completion
        {
            void* m_vtable[4] = {};
            std::atomic<std::int32_t> m_refs{ 1 };
            D* m_args = nullptr;

            static std::int32_t __stdcall qi(void* self, winrt_guid const& iid, void** result) noexcept
            {
                if (iid == iid_iunknown || iid == iid_iinspectable ||
                    iid == impl::iid_of_deferral)
                {
                    *result = self;
                    static_cast<deferral_completion*>(self)->m_refs.fetch_add(1, std::memory_order_relaxed);
                    return hr_ok;
                }
                *result = nullptr;
                return hr_no_interface;
            }

            static std::uint32_t __stdcall add_ref(void* self) noexcept
            {
                return static_cast<deferral_completion*>(self)->m_refs.fetch_add(1, std::memory_order_relaxed) + 1;
            }

            static std::uint32_t __stdcall release(void* self) noexcept
            {
                auto* me = static_cast<deferral_completion*>(self);
                std::int32_t remaining = me->m_refs.fetch_sub(1, std::memory_order_acq_rel) - 1;
                if (remaining == 0)
                {
                    delete me;
                }
                return remaining;
            }

            static std::int32_t __stdcall complete(void* self) noexcept
            {
                auto* me = static_cast<deferral_completion*>(self);
                try
                {
                    me->m_args->one_deferral_completed();
                }
                catch (...)
                {
                    return impl::to_hresult();
                }
                return hr_ok;
            }

            static deferral_completion* create(D& args)
            {
                auto* result = new deferral_completion;
                result->m_vtable[0] = reinterpret_cast<void*>(&qi);
                result->m_vtable[1] = reinterpret_cast<void*>(&add_ref);
                result->m_vtable[2] = reinterpret_cast<void*>(&release);
                result->m_vtable[3] = reinterpret_cast<void*>(&complete);
                result->m_args = &args;
                return result;
            }

            void* get_abi() const noexcept
            {
                return const_cast<void* const*>(m_vtable);
            }
        };

        export template <typename D, typename Deferral>
        struct deferral_wait_awaiter;
    }

    export template <typename D, typename Deferral>
    struct deferrable_event_args
    {
        Deferral GetDeferral()
        {
            slim_lock_guard const guard(m_lock);

            if (m_handle)
            {
                // Cannot ask for a deferral after the handler returned.
                throw hresult_illegal_method_call();
            }

            auto* completion = impl::deferral_completion<D>::create(static_cast<D&>(*this));
            Deferral deferral = Deferral::from_abi(completion->get_abi());
            ++m_outstanding;
            return deferral;
        }

        // coroutine that resumes on the thread pool once every outstanding
        // deferral has completed; await with `co_await args.wait_for_deferrals()`.
        [[nodiscard]] impl::deferral_wait_awaiter<D, Deferral> wait_for_deferrals() const noexcept
        {
            return impl::deferral_wait_awaiter<D, Deferral>{ *this };
        }

    private:

        void one_deferral_completed()
        {
            std::coroutine_handle<> resume = nullptr;
            {
                slim_lock_guard const guard(m_lock);

                if (m_outstanding <= 0)
                {
                    throw hresult_illegal_method_call();
                }

                if (--m_outstanding == 0)
                {
                    resume = m_handle;
                }
            }

            if (resume)
            {
                impl::resume_background(resume);
            }
        }

        template <typename, typename>
        friend struct impl::deferral_wait_awaiter;
        friend struct impl::deferral_completion<D>;

        mutable slim_mutex m_lock;
        mutable std::int32_t m_outstanding = 0;
        mutable std::coroutine_handle<> m_handle = nullptr;
    };

    namespace impl
    {
        export template <typename D, typename Deferral>
        struct deferral_wait_awaiter
        {
            deferrable_event_args<D, Deferral> const& m_args;

            bool await_ready() const noexcept
            {
                slim_lock_guard const guard(m_args.m_lock);
                return m_args.m_outstanding == 0;
            }

            bool await_suspend(std::coroutine_handle<> handle) noexcept
            {
                slim_lock_guard const guard(m_args.m_lock);
                m_args.m_handle = handle;
                return m_args.m_outstanding > 0;
            }

            void await_resume() const noexcept
            {
            }
        };
    }

    // custom thread pool for coroutine offload (thread_limits, etc.)

    // Header-free: std-based offload; the Win32 threadpool module is not
    // part of every project's closure. thread_limits is retained as a
    // no-op for source compatibility.
    export struct thread_pool
    {
        bool await_ready() const noexcept
        {
            return false;
        }

        void await_resume() const noexcept
        {
        }

        void await_suspend(std::coroutine_handle<> handle)
        {
            std::thread([handle] { handle(); }).detach();
        }

        void thread_limits(std::uint32_t const, std::uint32_t const) noexcept
        {
        }
    };
}
        )cppwinc");
        return s;
    }();


    export inline constexpr std::string_view std_import = "export import std;\n";

    // module preambles

    export inline constexpr std::string_view module_preamble = R"cppwinc(
